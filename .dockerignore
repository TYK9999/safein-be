# Build-context excludes — keep the context small and never bake secrets/artifacts in.
node_modules
dist
coverage
.git
.gitignore
.github

# Secrets — env is injected at runtime via docker compose env_file, never copied in.
.env
.env.*

# Local-only + dev artifacts
data
localstack
*.log
docs
api

# Deploy + container meta (not needed inside the image)
deploy
Dockerfile
.dockerignore
docker-compose*.yml
README.md
