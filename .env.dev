# Copy to `.env` and adjust. Never commit real secrets.
# Node >= 20
#
# Local Postgres is the Compose service in docker-compose.yml.
# Nest runs on the host and connects via localhost — not the Compose service hostname.
# Host port 5433 avoids clashing with a local Postgres already on 5432.

# Use production on EC2 / Docker prod (compose forces production in docker-compose.prod.yml).
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Case-insensitive: debug | info | warn | error (also fatal|trace|silent).

DATABASE_URL=postgresql://postgres:fr3YPyIcyttc594ieKNe@database-1.cluster-ceh2eg8eu2q1.us-east-1.rds.amazonaws.com:5432/safein?sslmode=require


# Auth cookie session (no silent runtime defaults). Local examples only — never commit real secrets.
AUTH_JWT_SECRET=d78b17beef1947c513395d5eb5b89be61d58202b7d40e36ef77d4dedb7e3cbc5
# JWT lifetime (documented intent: 43200 = 12 hours)
AUTH_TOKEN_TTL_SECONDS=43200
# Concurrent rotation window for the previous token hash (documented intent: 60)
AUTH_TOKEN_PREVIOUS_WINDOW_SECONDS=60
# Persistent cookie Max-Age when keepSignedIn is true (documented intent: 2592000 = 30 days)
AUTH_COOKIE_MAX_AGE_SECONDS=2592000

# lax = same-site / local dev. none = cross-site credentialed API (EC2 API + localhost FE); requires NODE_ENV=production.
AUTH_COOKIE_SAMESITE=none

# Credentialed CORS: `*` reflects any browser Origin, or comma-separated http(s) URLs.
# Tighten to explicit origins before production hardening.
CORS_ORIGINS=*


# Optional OTP email (AWS SES). Omit both to skip send; use dev console OTP when NODE_ENV=development.
# Credentials: standard AWS SDK chain (e.g. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or instance role).
# SES_REGION=eu-west-2
# SES_FROM_EMAIL=noreply@your-verified-domain.com