# Copy to `.env` and adjust. Never commit real secrets.
# Node >= 20

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Case-insensitive: debug | info | warn | error (also fatal|trace|silent). DEBUG/INFO/WARN/ERROR accepted.

# Host Postgres (local install). Default port 5432 — do not use Docker Postgres for local dev.
# Create DB first, e.g.:
#   psql -U postgres -c "CREATE USER safein5 WITH PASSWORD 'safein5' CREATEDB;"
#   psql -U postgres -c "CREATE DATABASE safein5 OWNER safein5;"
# Or point at an existing database/user:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/safein5

# Browser origins for HTTP CORS + Socket.IO (credentials enabled).
SOCKET_IO_CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# CORS_ORIGINS=  # optional override; defaults to SOCKET_IO_CORS_ORIGINS

# AWS (SES/SNS messaging + S3/Transcribe media)
AWS_REGION=ap-south-1
SES_FROM_EMAIL=noreply@example.com
# SES_REPLY_TO=support@example.com
# SNS_SMS_TYPE=Transactional
# SNS_SMS_SENDER_ID=SafeIn5
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# JWT (EdDSA). Blank keys in non-prod => ephemeral keypair at boot.
# Access token is short-lived. Refresh cookie keeps the session without another OTP.
JWT_ISSUER=safein5
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# OTP (sign-up and sign-in)
OTP_TTL=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=CHANGE_ME_min_16_chars

# Cookies
REFRESH_COOKIE_NAME=safein5_rt
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Video uploads (S3 multipart)
S3_BUCKET_NAME=safein5-dev
S3_FORCE_PATH_STYLE=false
# S3_ENDPOINT=
UPLOAD_MAX_PART_BYTES=20971520
UPLOAD_MAX_PARTS=10000
UPLOAD_SESSION_TTL_MINUTES=1440
UPLOAD_REAPER_CRON=0 * * * *
UPLOAD_REAPER_ENABLED=false
UPLOAD_URL_TTL_SECONDS=900
# UPLOAD_URL_SECRET=

# Thumbnails / playback (ffmpeg)
THUMBNAIL_SWEEP_ENABLED=true
THUMBNAIL_SWEEP_INTERVAL_MS=15000
THUMBNAIL_MAX_ATTEMPTS=3
PLAYBACK_SWEEP_ENABLED=true
PLAYBACK_SWEEP_INTERVAL_MS=15000
PLAYBACK_MAX_ATTEMPTS=3
PLAYBACK_FFMPEG_THREADS=1
# FFMPEG_PATH=

# Audio + STT
AUDIO_MAX_BYTES=26214400
TRANSCRIBE_LANGUAGE_OPTIONS=en-GB
# TRANSCRIBE_REGION=
# TRANSCRIBE_ENDPOINT=
# TRANSCRIBE_DEFAULT_LANGUAGE=en-US

# Take 5 (optional — endpoint returns AI_NOT_CONFIGURED until set)
# CURSOR_API_KEY=
# CURSOR_MODEL=
