# ---- Core ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,https://localhost:5173   # front-end origins allowed to call the API (CORS); comma-separated
# PUBLIC_BASE_URL=            # backend's public base for signed upload URLs; defaults to APP_URL
                             # set separately when the SPA and API are on different origins
LOG_LEVEL=debug

# ---- Database ----
# Point this at your local Postgres 'safein5' database (see db/README.md).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safein5

# ---- JWT (EdDSA) ----
# Leave BOTH blank in dev to auto-generate an ephemeral keypair at boot
# (tokens reset on restart). In production BOTH are required (PEM PKCS8/SPKI).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=safein5
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# ---- OTP / magic link ----
OTP_TTL=600                   # seconds (10 min)
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
MAGIC_LINK_TTL=900            # seconds (15 min)
OTP_HASH_SECRET=CHANGE_ME_min_16_chars   # required; hashes OTP/token values at rest

# ---- Cookies ----
REFRESH_COOKIE_NAME=safein5_rt
COOKIE_SECURE=false           # true behind HTTPS in production
COOKIE_DOMAIN=

# ---- Video uploads (local disk for now; S3 later) ----
DATA_DIR=./data               # root folder for video parts + assembled files
UPLOAD_MAX_PART_BYTES=20971520  # 20 MB; also the HTTP body limit per part
UPLOAD_MAX_PARTS=10000        # max parts a single upload may declare
# Reaper: sweep abandoned unfinished uploads (marks them 'expired', deletes parts)
UPLOAD_SESSION_TTL_MINUTES=1440 # no activity for this long => abandoned (24h); must be > 0
UPLOAD_REAPER_CRON=0 * * * *  # how often the reaper runs (hourly)
UPLOAD_REAPER_ENABLED=true    # set false to turn the reaper off
# Signed per-part upload URLs: client PUTs part bytes straight to the signed URL
UPLOAD_URL_SECRET=            # blank in dev => ephemeral (resets on restart); required in prod
UPLOAD_URL_TTL_SECONDS=900    # how long a signed part URL is valid (15 min)

# ---- Object storage ----
# Set S3_BUCKET_NAME to store parts + assembled videos in S3 instead of DATA_DIR.
# Leave it blank for local disk. The client upload flow is identical either way.
S3_BUCKET_NAME=              # e.g. safein-videos  (blank = local storage)
AWS_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000   # for S3-compatible stores (MinIO/LocalStack)
# S3_FORCE_PATH_STYLE=true            # required by MinIO/LocalStack
# AWS_ACCESS_KEY_ID=          # blank => AWS default credential chain (env/profile/IAM role)
# AWS_SECRET_ACCESS_KEY=

# ---- Video thumbnails (background ffmpeg frame extraction) ----
THUMBNAIL_SWEEP_ENABLED=true
THUMBNAIL_SWEEP_INTERVAL_MS=15000   # how often the sweep runs
THUMBNAIL_MAX_ATTEMPTS=3            # give up after this many failures per video
# FFMPEG_PATH=                      # blank => bundled ffmpeg-static; set to system ffmpeg in prod (shared by both sweeps)

# ---- Video playback (background transcode to a streamable H.264/AAC MP4) ----
# A completed upload transcodes IMMEDIATELY (fire-and-forget); the sweep is only a retry net.
PLAYBACK_SWEEP_ENABLED=true         # retry net for failed transcodes (never re-processes old uploads)
PLAYBACK_SWEEP_INTERVAL_MS=15000    # how often the retry sweep runs
PLAYBACK_MAX_ATTEMPTS=3             # give up after this many failures per video
PLAYBACK_FFMPEG_THREADS=1          # libx264 thread cap (protect the API); raise for spare cores

# ---- Audio clips + speech-to-text (AWS Transcribe) ----
AUDIO_MAX_BYTES=26214400            # 25 MiB cap for a <=2 min audio clip
# TRANSCRIBE_REGION=eu-west-2       # real AWS region for Transcribe; blank => AWS_REGION
TRANSCRIBE_LANGUAGE_OPTIONS=en-GB   # comma-separated IdentifyLanguage candidates
# TRANSCRIBE_ENDPOINT=http://localhost:4566   # blank => real AWS; set to a LocalStack Pro endpoint for local STT testing
# TRANSCRIBE_DEFAULT_LANGUAGE=en-US # pin language when a request omits `language`; blank => auto-detect (fine on real AWS). REQUIRED for LocalStack, whose emulator can't auto-detect (empty transcript otherwise)

# ===================================================================
# LocalStack profile — run BOTH S3 and Transcribe locally (STT without a real
# AWS account). Transcribe is LocalStack PRO, so you need LOCALSTACK_AUTH_TOKEN.
#   1) export LOCALSTACK_AUTH_TOKEN=<your token>   (free 14-day trial works)
#   2) docker compose --profile localstack up -d localstack
#      (an init hook auto-creates the bucket + browser CORS on every boot)
#   3) set the overrides below (Transcribe must read the SAME store the clip is in,
#      so S3 must be LocalStack too — not MinIO), then start the app.
# S3_ENDPOINT=http://localhost:4566
# TRANSCRIBE_ENDPOINT=http://localhost:4566
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# TRANSCRIBE_DEFAULT_LANGUAGE=en-US   # LocalStack can't auto-detect language
# ===================================================================
