// ============================================================
// SafeIn5 MVP - QR Codes & Context Resolution
// Generated from the live PostgreSQL 16 schema (db/migrations/0001-0008).
// Import at https://dbdiagram.io  ->  paste, or File > Import > DBML
// Context tables (shown for their relationships, owned by another subsystem): site, sub_site, asset
// ============================================================
Project SafeIn5_03_qr_context {
  database_type: 'PostgreSQL'
  Note: 'SafeIn5 MVP - QR Codes & Context Resolution'
}

TableGroup "QR Codes & Context Resolution" {
  task_type
  risk_type
  qr_context
  qr_code
  pulse_template
  context_binding
  qr_scan_event
  rescue_plan
  learn5_item
}

TableGroup "Context (owned elsewhere)" {
  site
  sub_site
  asset
}

Table asset {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  site_id uuid [not null, note: 'Required. Every asset belongs to a site even when it is not pinned to a sub-site, so site-scoped feeds and RLS-adjacent scoping never need a NULL branch.']
  sub_site_id uuid [note: 'Optional. An asset may hang directly off a site (mobile plant that moves between zones) or off a specific sub-site. Must belong to the same tenant; agreement between asset.site_id and sub_site.site_id is enforced by trg_asset_sub_site_site_match.']
  external_ref text [note: '''The client's own asset/tag ID (e.g. "SB-14"). Free text because every quarry numbers its plant differently; unique per tenant when present so grouped insight queries do not split.''']
  name text [not null]
  asset_type text [not null, default: 'other', note: 'fixed_plant | mobile_plant | fixture | access_structure | other. Structured so "custom lifting fixtures" is a filter, not a text search.']
  status text [not null, default: 'active', note: 'one of: active | inactive | decommissioned']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_asset_id_tenant']
  }

  Note: 'A physical asset: fixed or mobile plant, a lifting fixture, an access structure. Deliberately a real table, not a free-text field: the flagship supervisor insight -- "3 similar Be Aware signals in 2 weeks, all on custom lifting fixtures" -- is a GROUP BY asset_id over behaviour_signal, and string matching would make that demo unreliable. Admin UX keeps assets optional.'
}

Table context_binding {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  actor_kind text [not null, note: 'user | guest. Discriminator for the polymorphic actor_ref. Deliberately not a FK pair, so guests and members share one cache and one deletion path.']
  actor_ref uuid [not null, note: 'app_user.id when actor_kind=user, guest_session.id when actor_kind=guest. NOT an author_token: this is operational routing state, not attributable content, and it is already tenant-scoped. No FK -- the column is polymorphic by design.']
  source text [not null, note: 'qr | geo | manual | assignment. How the binding was established; qr always wins over the others because it is the only physically verified evidence of where the actor is.']
  site_id uuid
  sub_site_id uuid
  asset_id uuid
  qr_code_id uuid
  qr_context_id uuid [note: 'The context that produced this binding when source=qr. Kept alongside qr_code_id so a re-pointed sticker does not retroactively change what an existing binding meant.']
  task_type_code text
  risk_type_code text
  context_snapshot jsonb [note: 'Denormalised copy of the resolved context envelope (names as well as ids) so the PWA context chip renders with no joins. Advisory cache only -- the immutable historical copies live on pulse_session and behaviour_signal.']
  bound_at timestamptz [not null, default: `now()`, note: '[SIGNAL] When this binding was (re)established. The per-actor sequence of bound_at values is the movement trace the Gather stage consumes; expired rows are therefore retained, not purged.']
  expires_at timestamptz [not null, default: `(now() + '08:00:00'::interval)`, note: 'Default now() + 8 hours = one shift. Treated as absent past this point; see the table comment for the full staleness rule.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete (e.g. GDPR erasure of a guest session). Never hard-deleted.']

  Note: 'Context Engine cache: "given this actor and this entry point, what is the operative context?" (Architecture Sec 1.2 module 8, Sec 2.3). Answers WRK-015/016 -- scanning another QR UPSERTs this one row and the feed filter, capture context and Learn5 selection all follow, instead of five callers re-deriving context. STALENESS: valid until expires_at (default now()+8h, one shift); past that it is treated as ABSENT and the engine falls back to user_site_assignment, then manual. Never silently extended.'
}

Table learn5_item {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [note: 'NULL => SafeIn5-global item, readable by all tenants. Non-null => tenant-private item. Drives the special RLS policy on this table (section 6.1).']
  title text [not null]
  summary text
  body_md text [note: 'Markdown body for delivery_mode = native. Rendered client-side; no HTML is stored.']
  media_key text [note: 'Object-store key of the primary media asset. Not a presigned URL -- URLs are minted per request with a short TTL (Architecture Sec 5).']
  media_kind text [note: 'Kind of the asset at media_key: image | video | audio | pdf.']
  external_url text [note: 'Target for delivery_mode = external (Dev Pack Sec 8.4 Option 1). Retained as the fallback adapter per PRD Sec 5.8.']
  delivery_mode text [not null, default: 'native', note: 'native (content hosted in SafeIn5, PRD Sec 5.8 decision) | external (adapter fallback, Dev Pack Sec 8.4 Option 1).']
  risk_type_code text [note: '[SIGNAL] Structured risk vocabulary, not free text -- one of the two grouping axes the future SIGNAL intelligence layer clusters on.']
  task_type_code text [note: '[SIGNAL] Structured task vocabulary, not free text -- the second SIGNAL grouping axis.']
  tags text[] [not null, default: '{}', note: '[SIGNAL] Free-form editorial tags. Complements, never replaces, risk_type_code/task_type_code.']
  estimated_seconds integer [note: 'Expected consumption time, shown to the worker before opening and used as the denominator for the Learn5 completion-rate metric (Dev Pack Sec 14).']
  version integer [not null, default: 1, note: 'Editorial version. Incremented on republish so a learn5_view recorded months ago can be read against the copy that was live at the time.']
  status text [not null, default: 'draft', note: 'one of: draft | published | archived']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Never hard delete -- learn5_view rows reference this item and the engagement metric must survive content retirement.']

  Note: 'Micro-learning content (Dev Pack Sec 8.4, Architecture Sec 2.5). tenant_id NULL means SafeIn5-global content readable by every tenant including Community (CQA-010). Because tenant_id is nullable there is no (id, tenant_id) key, so every FK pointing here is single-column and tenant agreement is enforced by the write path plus RLS.'
}

Table pulse_template {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [note: 'NULL means a SafeIn5-global template available to every tenant (including Community). Non-NULL means tenant-private. RLS USING admits both; RLS WITH CHECK admits only the caller tenant, so the app role cannot mint global templates.']
  name text [not null]
  description text
  steps jsonb [not null, default: '[]', note: 'Ordered jsonb array of exactly 5 objects keyed P|U|L|S|E: [{"key":"P","heading":"...","prompt":"...","learn5_item_id":"<uuid>"}, ...]. steps[].learn5_item_id CANNOT be a foreign key (nested in jsonb); it is existence- and tenant-checked in the same transaction on write and degrades to a missing link on read. For an ENFORCED template-to-Learn5 relationship use learn5_binding.pulse_template_id (0004), which is a real FK.']
  risk_type_code text [note: '[SIGNAL] Risk this template is written for; drives GET /v1/pulse/templates/resolve fallback when a qr_context has no explicit template.']
  task_type_code text [note: '[SIGNAL] Optional secondary resolution axis. Symmetrical with risk_type_code; resolution prefers risk_type_code.']
  version integer [not null, default: 1, note: 'Monotonic per (tenant scope, name). Editing a published template creates a new version row rather than mutating history, so a six-month-old pulse_session can be read against the prompts actually shown.']
  status text [not null, default: 'draft', note: 'draft | active | archived. text + CHECK, never a PG ENUM, so Phase 2 adds a state with an ALTER CHECK.']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. A template referenced by a historic pulse_session must remain readable.']

  Note: 'PULSE prompt set (Architecture Sec 2.3, WRK-005 contextual PULSE prompts). One row = one versioned set of the five P/U/L/S/E steps. Referenced by qr_context.pulse_template_id and resolved by GET /v1/pulse/templates/resolve.'
}

Table qr_code {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  token character(12) [not null, unique, note: 'THE URL PATH SEGMENT: https://s5.app/q/<token>. 12 chars of Crockford base32 (no I/L/O/U -- no ambiguity, no accidental words), 60 bits of CSPRNG entropy, case-insensitive so it doubles as a human-typed fallback. Opaque: it carries no signature and no expiry, because a token that expires is a sticker that must be reprinted. All authority lives in qr_code.status, which is server-side and instantly revocable.']
  label text [not null, note: 'Human name in the admin list, e.g. "Lifting Zone 3 barrier".']
  qr_context_id uuid [note: 'Nullable while status=draft (token minted before the admin binds destinations, Sec 6.3). Re-point the sticker by UPDATEing this column.']
  status text [not null, default: 'draft', note: 'draft | active | inactive | revoked. REVOKED IS NOT DELETED. RESOLVER CONTRACT (Sec 6.2 hard rule 4): unknown token -> 200 {status:"unknown"}; inactive -> 200 {status:"inactive"}; revoked -> 200 {status:"retired", fallback:{siteName}}. Never 404 a physical safety sticker. Because unknown and revoked are distinguishable only if the row survives, revoked rows are NEVER deleted and deleted_at is never set on a revoked code that is still physically mounted.']
  sticker_serial text [note: 'Optional physical inventory serial, matching the additive ?s=<sticker_serial> query param. Never authoritative for resolution; logged for QA-004 placement verification.']
  verified_at timestamptz [note: 'QA-004 "QR tested/active": set when someone has physically scanned the mounted sticker and confirmed it routes correctly.']
  verified_by_membership_id uuid [note: 'Membership that performed the physical verification. Not anonymous -- QR verification is an admin/supervisor action (Architecture Sec 4.3).']
  printed_asset_url text [note: 'Object-store key of the generated print-ready PNG/SVG (qrcode lib, ECC level H for mud, abrasion and UV).']
  scan_count bigint [not null, default: 0, note: 'Denormalised counter, incremented fire-and-forget on resolve. The authoritative per-scan record is qr_scan_event below.']
  last_scanned_at timestamptz [note: 'Denormalised. Powers the admin "never scanned since printing" placement-check list.']
  activated_at timestamptz
  revoked_at timestamptz
  revoked_reason text [note: 'Why the sticker was retired. Never shown publicly; shown in admin and copied into the audit_log entry.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_qr_code_id_tenant']
  }

  Note: 'One physical printed QR sticker (Architecture Sec 2.3 / Sec 6). Points at a qr_context, which is what makes re-pointing a sticker an UPDATE rather than a reprint. ~30 rows in the pilot.'
}

Table qr_context {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null, note: 'Admin-facing name, e.g. "Heavy lift - Lifting Zone 3".']
  description text
  site_id uuid [note: 'Nullable. Dev Pack Sec 8.2 context dimension. Denormalised into the resolve envelope and into every context_snapshot.']
  sub_site_id uuid [note: 'Nullable. Sub-site (area / zone / task_zone / asset_group) dimension.']
  asset_id uuid [note: 'Nullable. The "Asset ID = spreader beam" dimension; the GROUP BY that carries the flagship supervisor insight.']
  task_type_code text [note: '''[SIGNAL] FK to the global task_type vocabulary. Named *_code rather than the architecture doc's bare "task_type" so the FK relationship is explicit and greppable; the resolve envelope still exposes it as taskType.''']
  risk_type_code text [note: '[SIGNAL] FK to the global risk_type vocabulary. See task_type_code for the naming rationale.']
  destinations jsonb [not null, default: '[]', note: 'Ordered jsonb array of {"type":"pulse|rescue_plan|learn5|feed|capture","ref":"<uuid>","label":"..."} (Dev Pack Sec 8.6: one QR -> survey + rescue plan + PULSE + Learn5). Order is the render order in the resolve envelope. "ref" is intentionally NOT FK-enforced -- it is polymorphic across pulse_template, rescue_plan and learn5_item. Replacement controls: same-transaction validation on write, resolve-time LEFT JOIN with silent omission on read (never 404 a printed code), soft-delete-only content, and a nightly worker integrity report. The PRIMARY destination of each kind is duplicated into the real FK columns pulse_template_id / rescue_plan_id / learn5_item_id.']
  default_destination text [note: 'one of: pulse | rescue_plan | learn5 | feed | capture. Which destination auto-opens after a scan (normally "pulse"). Matched by "type" against destinations[]; NULL means the PWA renders the destination list without auto-navigating.']
  pulse_template_id uuid [note: 'Contextual PULSE prompts (WRK-005). Redundant with a destinations[] entry of type "pulse" and deliberately so: the resolver reads this column in the single indexed join rather than parsing jsonb.']
  rescue_plan_id uuid [note: 'Primary rescue plan destination (Dev Pack Sec 8.3). Column declared in 0003, foreign key fk_qr_context_rescue_plan added in 0004 once rescue_plan exists. Same read-path rationale as pulse_template_id.']
  learn5_item_id uuid [note: 'Primary Learn5 destination. Column declared in 0003, foreign key fk_qr_context_learn5_item added in 0004. Additional Learn5 items attach through learn5_binding (qr_context_id target).']
  context_version integer [not null, default: 1, note: '[SIGNAL] Incremented by the application on every edit to the context definition. Lets a six-month-old signal be interpreted against the context definition in force at capture time; the value is copied into every context_snapshot. Backfill-impossible if omitted.']
  status text [not null, default: 'draft', note: 'draft | active | archived. Note the physical CODE has its own status (qr_code.status); this one governs the logical context.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete only. A deleted context must still resolve for audit and for historic context_snapshot interpretation.']

  indexes {
    (id, tenant_id) [unique, name: 'uq_qr_context_id_tenant']
  }

  Note: 'Resolved-destination definition for a QR entry point (Dev Pack Sec 8.2, Architecture Sec 2.3). Deliberately separate from qr_code so a physical sticker can be re-pointed by UPDATEing qr_code.qr_context_id -- no reprint, no site visit -- and so many codes can share one context.'
}

Table qr_scan_event {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  qr_code_id uuid [not null]
  qr_context_id uuid [note: 'The context the code resolved to AT SCAN TIME. Stored alongside qr_code_id so a later re-point of the sticker does not retroactively change what a historical scan meant.']
  author_token character(32) [not null, note: '''The scanner's pseudonym. Guest or member, same shape. The ONLY actor key on this table.''']
  is_first_scan_for_token bool [not null, default: false, note: '''[SIGNAL] True on this token's first ever scan of this code. Materialised at write time because it is a cheap flag now and an expensive window function later.''']
  entry_point text [not null, default: 'qr', note: '[SIGNAL] qr (camera) | manual_code (typed the human-readable fallback) | deep_link. Distinguishing the typed fallback is how "the sticker is unreadable in the field" becomes measurable rather than anecdotal.']
  sticker_serial text [note: 'Additive ?s=<serial> param captured for QA-004 placement verification. Never authoritative for resolution.']
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Note: '[SIGNAL] Authoritative per-scan record behind the qr.scanned outbox event (Architecture Sec 6.2 step 4, Sec 8 Sense stage). QR scans are a named Phase 1 success metric and cannot be reconstructed from the denormalised qr_code.scan_count. KEYED BY author_token ONLY -- no user_id column exists on this table and none may be added (Architecture Sec 4.3).'
}

Table rescue_plan {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  site_id uuid [note: 'Scope. Resolution order is most-specific-first: asset_id, then sub_site_id, then site_id, then tenant-wide (all three NULL).']
  sub_site_id uuid
  asset_id uuid
  title text [not null]
  location_description text [note: 'Free text describing the physical location / access point, per Dev Pack Sec 8.3 "location / asset". Supplements, never replaces, the structured site/sub_site/asset scope.']
  immediate_actions jsonb [not null, default: '[]', note: 'ORDERED array of steps: [{"seq":1,"action":"...","detail":"..."}]. Order is safety-critical; it is carried by both array position and an explicit seq key so a reserialising client cannot silently reorder it.']
  roles_responsibilities jsonb [not null, default: '[]', note: 'Array of [{"role":"...","responsibility":"..."}] (Dev Pack Sec 8.3 "roles and responsibilities").']
  required_equipment jsonb [not null, default: '[]', note: 'Array of [{"item":"...","quantity":"...","location":"..."}] (Dev Pack Sec 8.3 "required equipment").']
  escalation_contacts jsonb [not null, default: '[]', note: 'Array of [{"name":"...","role":"...","phone":"..."}] (Dev Pack Sec 8.3 "escalation contacts"). Discrete phone values so the client can render a one-tap tel: link -- the single most time-critical element on the page.']
  version integer [not null, default: 1, note: 'Version, per Dev Pack Sec 8.3 "version / review date". Displayed to the worker so a printed copy can be reconciled against the live one.']
  review_date date [note: 'Scheduled review date (Dev Pack Sec 8.3). OPEN SAFETY QUESTION: no source document says what an expired review date does. Recommendation, and the behaviour assumed here: an expired plan is still DISPLAYED, with a staleness banner. Never withhold emergency content. This column is deliberately not a display gate anywhere in the schema.']
  status text [not null, default: 'draft', note: 'one of: draft | published | archived']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_rescue_plan_id_tenant']
  }

  Note: 'Task/location-specific emergency response procedure. Fields mirror Dev Pack Sec 8.3 exactly. Structured JSONB rather than a markdown blob because the mobile rendering must be scannable in an emergency -- individual actions, roles, equipment and phone numbers must be addressable UI elements, not prose the client has to parse.'
}

Table risk_type {
  code text [pk, note: '[SIGNAL] Stable machine code, denormalised onto qr_context, pulse_template, learn5_item and behaviour_signal. The primary axis of Phase-2 pattern detection.']
  label text [not null, note: 'Human label for admin pickers and the PWA context chip.']
  description text
  sort_order integer [not null, default: 100]
  is_active bool [not null, default: true, note: 'false hides the code from new pickers but leaves every existing reference valid.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'Global seeded vocabulary of hazard/risk types (Dev Pack Sec 8.2 QR context dimension "risk type"). Not tenant-scoped, no RLS. Never deleted; deactivate with is_active.'
}

Table site {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null]
  city text
  country_code character(2)
  timezone text [not null, default: 'Europe/London', note: '[SIGNAL] IANA timezone name. Shift and time-of-day pattern analysis requires local time, and this is uncorrectable retrospectively once signals have been captured against a wrong or absent zone.']
  centroid_lat numeric(9,6) [note: '[SIGNAL] Site centroid latitude, numeric(9,6) (~0.1 m precision). Feeds geo clustering and proximity context resolution (ADM-006).']
  centroid_lon numeric(9,6) [note: '[SIGNAL] Site centroid longitude. See centroid_lat.']
  status text [not null, default: 'active', note: 'one of: active | inactive']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Sub-sites, assets, QR contexts and signals reference this row.']

  indexes {
    (id, tenant_id) [unique, name: 'uq_site_id_tenant']
  }

  Note: 'A physical site (e.g. a quarry) belonging to a tenant (= one client organisation). Top of the context hierarchy used by QR resolution, feed scoping and user_site_assignment.'
}

Table sub_site {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  site_id uuid [not null]
  parent_sub_site_id uuid [note: 'Optional parent sub-site, same site and same tenant. Nullable self-FK: SafeIn5 explicitly warned against complex hierarchy (WRK-013 amendment), so MVP caps depth at 1 -- but the column costs nothing now and avoids a migration if Phase 2 needs depth.']
  name text [not null]
  kind text [not null, default: 'area', note: 'area | zone | task_zone | asset_group. Structured rather than free text because these are grouping keys the future SIGNAL layer depends on (Open-Questions: hierarchy model).']
  centroid_lat numeric(9,6) [note: '[SIGNAL] Zone centroid latitude; geo-based context resolution and clustering.']
  centroid_lon numeric(9,6) [note: '[SIGNAL] Zone centroid longitude.']
  status text [not null, default: 'active', note: 'one of: active | inactive']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_sub_site_id_tenant']
  }

  Note: 'A named area/zone within a site -- the level at which QR codes, feeds and Learn5 bindings are usually scoped. Self-nesting is permitted structurally but capped at one level of nesting in MVP by trg_sub_site_depth_cap.'
}

Table task_type {
  code text [pk, note: '[SIGNAL] Stable machine code. This is the value denormalised onto qr_context, pulse_session and behaviour_signal; it must never be renamed once written. One of the two grouping keys Phase-2 pattern detection runs on.']
  label text [not null, note: 'Human label rendered in admin and in the PWA context chip ("Brackley North . Lifting Zone 3 . Heavy Lift").']
  description text
  sort_order integer [not null, default: 100, note: 'Display order in admin pickers. Ascending.']
  is_active bool [not null, default: true, note: 'false hides the code from new pickers but leaves every existing reference valid.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'Global seeded vocabulary of work-task types (Dev Pack Sec 8.2 QR context dimension "task type"). Not tenant-scoped, no RLS: shared reference data. Never deleted; deactivate with is_active so historic qr_context / behaviour_signal rows keep resolving.'
}

// ---------- Relationships ----------
Ref fk_asset_site: asset.(site_id, tenant_id) > site.(id, tenant_id)
Ref fk_asset_sub_site: asset.(sub_site_id, tenant_id) > sub_site.(id, tenant_id)
Ref fk_context_binding_asset: context_binding.(asset_id, tenant_id) > asset.(id, tenant_id)
Ref fk_context_binding_qr_code: context_binding.(qr_code_id, tenant_id) > qr_code.(id, tenant_id)
Ref fk_context_binding_qr_context: context_binding.(qr_context_id, tenant_id) > qr_context.(id, tenant_id)
Ref fk_context_binding_risk_type: context_binding.risk_type_code > risk_type.code
Ref fk_context_binding_site: context_binding.(site_id, tenant_id) > site.(id, tenant_id)
Ref fk_context_binding_sub_site: context_binding.(sub_site_id, tenant_id) > sub_site.(id, tenant_id)
Ref fk_context_binding_task_type: context_binding.task_type_code > task_type.code
Ref fk_learn5_item_risk_type: learn5_item.risk_type_code > risk_type.code
Ref fk_learn5_item_task_type: learn5_item.task_type_code > task_type.code
Ref fk_pulse_template_risk_type: pulse_template.risk_type_code > risk_type.code
Ref fk_pulse_template_task_type: pulse_template.task_type_code > task_type.code
Ref fk_qr_code_qr_context: qr_code.(qr_context_id, tenant_id) > qr_context.(id, tenant_id)
Ref fk_qr_context_asset: qr_context.(asset_id, tenant_id) > asset.(id, tenant_id)
Ref fk_qr_context_learn5_item: qr_context.learn5_item_id > learn5_item.id
Ref fk_qr_context_pulse_template: qr_context.pulse_template_id > pulse_template.id
Ref fk_qr_context_rescue_plan: qr_context.(rescue_plan_id, tenant_id) > rescue_plan.(id, tenant_id)
Ref fk_qr_context_risk_type: qr_context.risk_type_code > risk_type.code
Ref fk_qr_context_site: qr_context.(site_id, tenant_id) > site.(id, tenant_id)
Ref fk_qr_context_sub_site: qr_context.(sub_site_id, tenant_id) > sub_site.(id, tenant_id)
Ref fk_qr_context_task_type: qr_context.task_type_code > task_type.code
Ref fk_qr_scan_event_qr_code: qr_scan_event.(qr_code_id, tenant_id) > qr_code.(id, tenant_id)
Ref fk_qr_scan_event_qr_context: qr_scan_event.(qr_context_id, tenant_id) > qr_context.(id, tenant_id)
Ref fk_rescue_plan_asset: rescue_plan.(asset_id, tenant_id) > asset.(id, tenant_id)
Ref fk_rescue_plan_site: rescue_plan.(site_id, tenant_id) > site.(id, tenant_id)
Ref fk_rescue_plan_sub_site: rescue_plan.(sub_site_id, tenant_id) > sub_site.(id, tenant_id)
Ref fk_sub_site_parent: sub_site.(parent_sub_site_id, tenant_id) > sub_site.(id, tenant_id)
