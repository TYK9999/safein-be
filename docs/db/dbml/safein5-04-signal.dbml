// out of scope: learn5_view.tenant_id -> tenant
// out of scope: pulse_session.author_user_id -> app_user
// out of scope: pulse_session.guest_session_id+tenant_id -> guest_session
// out of scope: pulse_session.pulse_template_id -> pulse_template
// out of scope: pulse_session.risk_type_code -> risk_type
// out of scope: pulse_session.task_type_code -> task_type
// out of scope: pulse_session.tenant_id -> tenant
// out of scope: qr_code.qr_context_id+tenant_id -> qr_context
