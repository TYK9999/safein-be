// ============================================================
// SafeIn5 MVP - COMPLETE SCHEMA (39 tables)
// Generated from the live PostgreSQL 16 schema (db/migrations/0001-0008).
// Import at https://dbdiagram.io  ->  paste, or File > Import > DBML
// ============================================================
Project SafeIn5 {
  database_type: 'PostgreSQL'
  Note: 'SafeIn5 behavioural safety platform - MVP schema. 39 tables, multi-tenant with row-level security. Anonymity is enforced by a database CHECK: is_anonymous = true implies author_user_id IS NULL.'
}

TableGroup "Tenancy & Organisation Hierarchy" {
  tenant
  site
  sub_site
  asset
  role
}

TableGroup "Identity, Membership & Anonymity" {
  app_user
  user_tenant_membership
  user_site_assignment
  guest_session
  auth_token
  tenant_secret
}

TableGroup "QR Codes & Context Resolution" {
  task_type
  risk_type
  qr_context
  qr_code
  pulse_template
  context_binding
  qr_scan_event
  rescue_plan
  learn5_item
}

TableGroup "Signal Core, Media & Learning" {
  classification
  pulse_session
  behaviour_signal
  signal_media
  signal_classification_event
  signal_read_state
  learn5_binding
  learn5_view
}

TableGroup "Workflow, Moderation, Audit & Notifications" {
  workflow_state_def
  workflow_transition_def
  review_task
  workflow_transition
  evidence
  moderation_action
  audit_log
  device_subscription
  notification
  outbox_event
}

Table app_user {
  id uuid [pk, default: `gen_random_uuid()`]
  email citext [note: 'Nullable: guest-derived accounts have no email until they register, and GDPR erasure sets it back to NULL. citext + partial unique index gives case-insensitive uniqueness over non-null values only.']
  email_verified_at timestamptz
  display_name text
  password_hash text [note: 'bcrypt. Admin/supervisor console logins only (ADM-001/002). Workers authenticate by magic link or email OTP and this stays NULL forever. SELECT on this column is withheld from safein5_app and granted only to safein5_identity (0007).']
  default_anonymous bool [not null, default: false, note: 'Account-level anonymity toggle (PRD Sec 5.5). This is the DEFAULT applied at capture time; user_tenant_membership.anonymous_override wins per tenant. Changing it never rewrites already-captured signals -- behaviour_signal.is_anonymous is materialised at capture (Architecture Sec 2.4).']
  locale text [not null, default: 'en-GB', note: '[SIGNAL / Phase-2 i18n] Written at MVP, unread by any MVP feature. BCP-47-ish tag, default en-GB for the UK quarry pilot.']
  status text [not null, default: 'active', note: 'active | blocked | erased. Enumeration is text + CHECK, never a PG ENUM, so Phase 2 adds a state with an ALTER of the CHECK rather than ALTER TYPE.']
  erased_at timestamptz [note: 'GDPR Art.17 tombstone timestamp (Architecture Sec 4.4). Erasure NEVER deletes this row: it scrubs identifiers here and DESTROYS the token mapping in user_tenant_membership, after which author_token is mathematically unresolvable and the retained safety signals cease to be personal data.']
  last_seen_at timestamptz [note: 'Coarse activity marker for the admin user directory (ADM-024). Not an audit trail -- audit_log is.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Nothing in SafeIn5 hard-deletes an identity; erasure is tombstoning (status=erased) plus mapping destruction, never a DELETE.']

  Note: 'Global (NOT tenant-scoped, NOT RLS-scoped) person identity. One row per human across all tenants, so a Community user can join a Corporate tenant without re-registering (CQA-001/SCP-001). Tenant-specific facts live on user_tenant_membership. Named app_user because "user" is a Postgres reserved word.'
}

Table asset {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  site_id uuid [not null, note: 'Required. Every asset belongs to a site even when it is not pinned to a sub-site, so site-scoped feeds and RLS-adjacent scoping never need a NULL branch.']
  sub_site_id uuid [note: 'Optional. An asset may hang directly off a site (mobile plant that moves between zones) or off a specific sub-site. Must belong to the same tenant; agreement between asset.site_id and sub_site.site_id is enforced by trg_asset_sub_site_site_match.']
  external_ref text [note: '''The client's own asset/tag ID (e.g. "SB-14"). Free text because every quarry numbers its plant differently; unique per tenant when present so grouped insight queries do not split.''']
  name text [not null]
  asset_type text [not null, default: 'other', note: 'fixed_plant | mobile_plant | fixture | access_structure | other. Structured so "custom lifting fixtures" is a filter, not a text search.']
  status text [not null, default: 'active', note: 'one of: active | inactive | decommissioned']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_asset_id_tenant']
  }

  Note: 'A physical asset: fixed or mobile plant, a lifting fixture, an access structure. Deliberately a real table, not a free-text field: the flagship supervisor insight -- "3 similar Be Aware signals in 2 weeks, all on custom lifting fixtures" -- is a GROUP BY asset_id over behaviour_signal, and string matching would make that demo unreliable. Admin UX keeps assets optional.'
}

Table audit_log {
  id bigint [not null, default: `nextval('audit_log_id_seq'::regclass)`, note: 'Monotonic ordering within the logical table. Sequence-backed rather than IDENTITY because PG16 does not allow identity columns on partitioned tables. Part of the PK together with the partition key.']
  tenant_id uuid [not null]
  occurred_at timestamptz [not null, default: `now()`, note: 'Partition key. Business time of the audited action, set by the caller; created_at is the row-write time. They differ when the worker back-writes an audit row for a queued event.']
  actor_type text [not null, note: 'one of: user | guest | system | admin']
  actor_token character(32) [note: 'The actor pseudonym (author_token), NEVER a user_id, whenever the subject is an anonymous author. This column IS the "user identity masked in audit logs" requirement (Architecture Sec 4.3, Proposal slide 18). char(32) matches user_tenant_membership.author_token / guest_session.author_token exactly; there is deliberately no author_user_id column on this table at all.']
  actor_membership_id uuid [note: 'Populated for admin/supervisor actions, which are NOT anonymous and must be attributable. Intentionally has NO foreign key: GDPR erasure deletes user_tenant_membership rows to destroy the pseudonym mapping, and an audit trail that can be truncated by a data-subject request is not an audit trail. The id becomes a dangling reference by design.']
  action text [not null]
  entity_type text [not null]
  entity_id text [note: 'text, not uuid: most entities are uuid-keyed but some are code-keyed (workflow_state_def.code, classification.code, tenant slug) and audit must cover them without a second column.']
  before jsonb [note: 'Pre-change state, PII-redacted by the serialiser allowlist (never raw row JSON -- a raw dump would reintroduce the email/user_id that the rest of this schema removes).']
  after jsonb [note: 'Post-change state, same allowlist as before.']
  request_id text [note: 'Correlates an audit row with the API request log and with outbox_event rows emitted in the same transaction.']
  ip_hash character(64) [note: 'SHA-256 of (ip || per-tenant salt). HASHED, NOT RAW -- GDPR data minimisation: enough to detect one actor hammering an endpoint, not enough to geolocate a named worker.']
  user_agent_hash character(64) [note: 'SHA-256 of the user-agent string. Hashed for the same reason; a full UA string plus a timestamp is a strong device fingerprint and would undermine anonymity.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id, occurred_at) [pk]
  }

  Note: 'APPEND-ONLY audit trail (Dev Pack Sec 7 "full audit trail maintained"). No UPDATE/DELETE grant to any runtime role (0007). Partitioned monthly by occurred_at so retention per tenant.retention_policy.audit_days is executed as DROP TABLE of a partition.'
}

Table auth_token {
  id uuid [pk, default: `gen_random_uuid()`]
  kind text [not null, note: 'magic_link | otp | invitation | password_reset. text + CHECK, never a PG ENUM. Different TTLs per kind are an application policy (OTP ~10 min, magic link ~15 min, invitation ~7 days), not a DB constraint.']
  token_hash character(64) [not null, note: 'SHA-256 (lowercase hex) of the emailed token or OTP code, salted with the same KMS pepper family as author_token. The plaintext token exists only in the email and in the request that redeems it. A stolen database grants no logins.']
  user_id uuid [note: 'NULL for an invitation to an email address that has no app_user row yet -- acceptance creates the user and the membership in one transaction.']
  email citext [note: 'The address the token was sent to, recorded even when user_id is set, so a later email change cannot silently re-target a live token.']
  tenant_id uuid [note: 'Required for invitations (which tenant the invitee is joining); NULL for magic link / OTP / password reset, where the tenant is only known after the user is identified and their memberships are read.']
  role_id uuid [note: 'Invitations only: the role the accepted membership will be created with (ADM-026 role assignment).']
  expires_at timestamptz [not null]
  consumed_at timestamptz [note: 'Single use. Also set when a token is SUPERSEDED by a newly issued one of the same kind for the same target -- which is what makes uq_auth_token_live_* enforceable without a now() predicate.']
  attempt_count integer [not null, default: 0, note: 'Failed redemption attempts. Guards OTP brute force: the Identity module rejects once attempt_count >= max_attempts and consumes the row.']
  max_attempts integer [not null, default: 5]
  ip_hash character(64) [note: 'Salted SHA-256 of the requesting address, never raw (GDPR minimisation). Abuse correlation only.']
  created_by_membership_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete for administrative revocation of an outstanding invitation. Expired/consumed rows are pruned by the retention job, not by user action.']

  Note: 'Single-use credentials for magic link, email OTP, admin invitation (ADM-026) and admin password reset (ADM-003). Stores a HASH only -- never the token. Not RLS-scoped because these rows are created before any tenant context exists; see the block comment above the table for what protects them instead.'
}

Table behaviour_signal {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Client-generated UUIDv7, minted on-device before the first network call, which is what makes POST /v1/signals/draft idempotent under retry. The gen_random_uuid() default is a fallback for server-side/admin inserts only.']
  tenant_id uuid [not null]
  status text [not null, default: 'draft', note: 'draft -> classified -> final, plus terminal discarded. Enforced here by CHECK, in the Signal facade by a transition guard, and on the wire by an optimistic UPDATE ... WHERE status = $expected. Three layers because a signal that regresses to draft mid-pilot is an unrecoverable data-integrity story. text + CHECK, never a PG ENUM.']
  visibility text [not null, default: 'site', note: '''site | tenant | public. The column DEFAULT is 'site' for every tenant, including Community -- there is no per-tenant default resolution in the schema. pol_community_public_read requires visibility = 'public', so a Community capture left on the default will NOT appear on the unauthenticated Community feed: the application must set visibility = 'public' explicitly when the capturing tenant is kind = 'community'. This is deliberate (fail closed, never leak), but it means the Community feed is empty until that write path exists. SCP-024: corporate content must never leak into the community feed, and this column plus pol_community_public_read is where that is enforced.''']
  author_token character(32) [not null, note: 'ALWAYS populated, anonymous or not. Deterministic one-way per-user-per-tenant HMAC pseudonym (Architecture Sec 4.2). This is what keeps repeat usage (the primary success measure), rate limiting, abuse blocking and closure notification working on anonymous signals. The same person is a different token in the Community tenant than in their employer tenant, so a corporate admin cannot correlate the two.']
  author_user_id uuid [note: 'NULL when the signal is anonymous. This single nullable FK IS the Dev Pack Sec 7 "strip user metadata at the DB level" requirement, made real: for an anonymous signal there is no user metadata on the row to strip. Guarded by ck_behaviour_signal_anonymity so the anonymity promise is a database invariant, not an application convention.']
  is_anonymous bool [not null, default: false, note: 'Materialised at capture time from the account-level setting (PRD Sec 5.5). Deliberately NOT read live from app_user.default_anonymous: the account setting may be flipped later, but the promise made to the worker at the moment of capture must be immutable.']
  guest_session_id uuid [note: 'Set for unauthenticated QR journeys (WRK-003). When a guest later registers, guest_session.promoted_user_id attaches their prior activity without re-keying any signal.']
  pulse_session_id uuid [note: 'Links Echo -> Signal. NULL for feed-entry captures that skip PULSE entirely.']
  qr_code_id uuid
  entry_point text [note: '[SIGNAL] qr | direct | feed | notification. Nullable because capture must never block on it.']
  classification_code text [note: 'NULL while draft -- classification is a separate tap in the flow and must not be a mandatory field at row creation.']
  classified_at timestamptz
  classification_latency_ms integer [note: '[SIGNAL] Client-measured milliseconds from the classification screen appearing to the tile being tapped. This is how the "<10s to classify" NFR is PROVEN AT UAT with real production data across every capture, instead of by stopwatch on a demo device. Backfill is impossible; drop this column and the NFR becomes an opinion.']
  capture_latency_ms integer [note: '[SIGNAL] Client-measured milliseconds from first tap to finalise. This is how the "<60s end-to-end capture" acceptance criterion is PROVEN AT UAT with real production data. Unreconstructable retrospectively, and it is the single number the pilot is judged on.']
  body_text text [note: 'Nullable. Zero mandatory fields at capture -- a photo and a classification is a complete, valuable signal.']
  body_source text [not null, default: 'none', note: 'typed | voice_transcript | none. CQA-006 wants evidence that voice-first is actually used rather than merely offered; this column is that evidence.']
  transcript_confidence numeric(4,3) [note: '[SIGNAL] 0..1 ASR confidence for voice_transcript bodies. Lets a future pass identify text that should be treated as unreliable.']
  site_id uuid [note: 'Denormalised from the resolved context so the feed filter (WRK-013/014) is one index scan with no join. context_snapshot remains the historical truth.']
  sub_site_id uuid [note: '''Denormalised from the resolved context. Drives WRK-013 auto-filter to the worker's current zone.''']
  asset_id uuid [note: 'Denormalised from the resolved context. The supervisor insight the product is sold on -- "3 similar Be Aware signals in 2 weeks, all on custom lifting fixtures" -- is a GROUP BY on this column, which is why asset is a real entity and not free text.']
  context_snapshot jsonb [not null, default: '{}', note: 'Immutable denormalised copy of the resolved context at capture time, including qr_context.context_version. Never updated. Lets a six-month-old signal be interpreted against the context definition that was in force when it was captured.']
  task_type_code text [note: '[SIGNAL] Structured, seeded vocabulary (heavy_lift, confined_space_entry, isolation, ...) copied from the QR context and FK-enforced against task_type. One of the two axes the future Identify/Gather pattern detection groups on -- deliberately NOT free text, because string matching would make the flagship analysis unreliable.']
  risk_type_code text [note: '[SIGNAL] Structured, seeded vocabulary (suspended_load, confined_space, dropped_object, ...) copied from the QR context and FK-enforced against risk_type. The second pattern-detection axis.']
  geo_lat numeric(9,6) [note: 'Optional, permission-gated. Rounded to 3 decimal places (~110 m) by the application before storage on anonymous signals: a precise fix on a specific work position identifies its author to anyone holding the crew roster, whatever is_anonymous says (Architecture Sec 4.3).']
  geo_lon numeric(9,6)
  geo_accuracy_m numeric(7,2)
  occurred_at timestamptz [not null, default: `now()`, note: 'When the observation happened. Defaults to capture time; a separate column because Phase 2 may allow backdating and retrofitting that distinction later is impossible.']
  finalised_at timestamptz
  media_state text [not null, default: 'none', note: 'none | pending | partial | ready | failed. DENORMALISED from signal_media and maintained by the media worker so the feed decides what to render (thumbnail / skeleton / nothing) without a join or subquery -- one index scan per feed page (Architecture Sec 5.4). The feed never waits for media and never hides a signal because its media is not ready.']
  moderation_state text [not null, default: 'visible', note: 'visible | hidden | removed | under_review. First-ever submission from a token in the Community tenant starts under_review. removed is a moderation outcome, not a delete -- the row survives for audit.']
  workflow_state text [note: 'NULL until a review_task exists. Denormalised from review_task.state (open | acknowledged | closed) for feed badges. MVP supervisor workflow is Acknowledge + Close only (PRD Sec 5.4).']
  search_vector tsvector [default: `to_tsvector('english'::regconfig, COALESCE(body_text, ''::text))`, note: 'Generated STORED tsvector over body_text. A generated column may only reference columns of the same row and its expression must be IMMUTABLE, which is why the regconfig is the literal english cast rather than a search_path-dependent lookup. Context terms are deliberately NOT concatenated in: they live in FK columns that are already indexed, and pulling them in would need a non-immutable join.']
  duplicate_of_id uuid [note: '[SIGNAL] Self-FK, tenant-composite. Dev Pack Sec 17.2 duplicate detection. MVP writes it only via an explicit moderator "mark duplicate" action; automated detection is Phase 2 against this same column.']
  similarity_group_id uuid [note: '[SIGNAL] Pure placeholder for Phase-2 clustering. Costs one nullable column now and a full backfill that can never be done later.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete (ADM-034). Never hard delete: GDPR erasure tombstones the user and destroys the token mapping, leaving the signal as genuinely anonymous safety knowledge (Architecture Sec 4.4).']

  indexes {
    (id, tenant_id) [unique, name: 'uq_behaviour_signal_id_tenant']
  }

  Note: 'The core object. Draft and final are the SAME ROW with a status column, not two tables -- splitting them would force a copy-and-delete on finalisation and break the signal_media FKs already attached during the draft phase (Architecture Sec 2.4). Zero mandatory fields at capture: a draft is insertable with tenant_id + author_token + status alone.'
}

Table classification {
  code text [pk, note: 'Stable machine code. Referenced by behaviour_signal.classification_code and carried in every outbox payload; never renamed once seeded.']
  label text [not null, unique, note: 'Worker-facing tile label. CQA-005: the agreed labels are Good Practice / Be Aware / Needs Attention Now. "Emerging Risk" and "Stop and Act Now" were explicitly rejected by the client and must not reappear.']
  severity_ordinal smallint [not null, unique, note: 'Ascending severity (1 = Good Practice .. 3 = Needs Attention Now). Exists so WRK-013 "red first" feed ordering happens in SQL -- ORDER BY severity_ordinal DESC, created_at DESC -- rather than being re-implemented (and drifting) in application code. UNIQUE so two tiers can never claim the same sort rank.']
  colour_token text [not null, note: 'one of: green | amber | red. Design-system colour token, not a hex value: theming is per-tenant (tenant.theme) and the mapping token -> hex belongs in the client.']
  sort_order integer [not null]
  triggers_workflow bool [not null, default: false, note: 'true => the outbox consumer WorkflowTaskCreator opens a review_task on signal.finalised. Only needs_attention_now at MVP. Config-as-data: turning Be Aware into a workflow trigger is an UPDATE, not a deploy.']
  is_active bool [not null, default: true, note: 'Soft retirement of a tier. Historic signals keep referencing an inactive code; the capture UI filters on is_active = true.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'Global, seeded reference list of the three SafeIn5 signal classifications. NOT tenant-scoped and NOT RLS-protected: ADM-035 gives it no CRUD in MVP and every tenant classifies against the same three tiles, which is what makes cross-tenant benchmarking possible later. text PK (not a PG ENUM) so Phase 2 adds a tier with an INSERT, never an ALTER TYPE.'
}

Table context_binding {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  actor_kind text [not null, note: 'user | guest. Discriminator for the polymorphic actor_ref. Deliberately not a FK pair, so guests and members share one cache and one deletion path.']
  actor_ref uuid [not null, note: 'app_user.id when actor_kind=user, guest_session.id when actor_kind=guest. NOT an author_token: this is operational routing state, not attributable content, and it is already tenant-scoped. No FK -- the column is polymorphic by design.']
  source text [not null, note: 'qr | geo | manual | assignment. How the binding was established; qr always wins over the others because it is the only physically verified evidence of where the actor is.']
  site_id uuid
  sub_site_id uuid
  asset_id uuid
  qr_code_id uuid
  qr_context_id uuid [note: 'The context that produced this binding when source=qr. Kept alongside qr_code_id so a re-pointed sticker does not retroactively change what an existing binding meant.']
  task_type_code text
  risk_type_code text
  context_snapshot jsonb [note: 'Denormalised copy of the resolved context envelope (names as well as ids) so the PWA context chip renders with no joins. Advisory cache only -- the immutable historical copies live on pulse_session and behaviour_signal.']
  bound_at timestamptz [not null, default: `now()`, note: '[SIGNAL] When this binding was (re)established. The per-actor sequence of bound_at values is the movement trace the Gather stage consumes; expired rows are therefore retained, not purged.']
  expires_at timestamptz [not null, default: `(now() + '08:00:00'::interval)`, note: 'Default now() + 8 hours = one shift. Treated as absent past this point; see the table comment for the full staleness rule.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete (e.g. GDPR erasure of a guest session). Never hard-deleted.']

  Note: 'Context Engine cache: "given this actor and this entry point, what is the operative context?" (Architecture Sec 1.2 module 8, Sec 2.3). Answers WRK-015/016 -- scanning another QR UPSERTs this one row and the feed filter, capture context and Learn5 selection all follow, instead of five callers re-deriving context. STALENESS: valid until expires_at (default now()+8h, one shift); past that it is treated as ABSENT and the engine falls back to user_site_assignment, then manual. Never silently extended.'
}

Table device_subscription {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  user_id uuid [not null, note: 'References app_user, not a membership: a browser install belongs to a person, and the same device may serve two tenants. tenant_id records which tenant context created the subscription and scopes RLS.']
  endpoint text [not null, unique, note: 'Push service URL returned by PushSubscription. Globally unique: the same browser must not be registered twice. Uniqueness is intentionally NOT scoped by tenant -- one physical browser is one endpoint, and a cross-tenant duplicate insert should fail loudly.']
  p256dh_key text [not null, note: 'Client public key for payload encryption (RFC 8291). Not a secret of ours, but useless without the endpoint.']
  auth_key text [not null, note: 'Client auth secret for payload encryption (RFC 8291).']
  user_agent text
  last_success_at timestamptz
  failure_count integer [not null, default: 0, note: 'Consecutive push failures. Backoff threshold for the dispatcher.']
  expired_at timestamptz [note: 'Set when the push service returns 404/410 (subscription gone). Row is retained and tombstoned, never hard deleted, so re-subscription churn per device stays measurable.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  Note: 'Web Push (VAPID) subscriptions. One row per browser/PWA install per user. PLATFORM LIMITATION, to be stated at UAT rather than filed as a bug: on iOS, Web Push requires iOS 16.4+ AND the PWA to have been added to the Home Screen -- Safari tabs cannot subscribe at all. On a UK quarry pilot with a majority-iPhone workforce this table will be sparsely populated, so push is a best-effort enhancement and the in-app notification row (channel = in_app) is the guaranteed delivery path. Never make a safety-critical loop (e.g. closure feedback, CQA-012) depend solely on web push.'
}

Table evidence {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  review_task_id uuid [not null]
  kind text [not null]
  storage_key text [note: 'Object-store key, tenant-prefixed exactly as signal_media (s3://bucket/{tenant_id}/...) so a per-tenant lifecycle or deletion policy covers evidence too.']
  note text
  mime_type text
  byte_size bigint
  checksum_sha256 character(64)
  uploaded_by_membership_id uuid [note: 'Evidence is a supervisor artefact and is never anonymous. Nulled by GDPR erasure of that membership rather than cascading.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  Note: 'Supporting evidence attached to a review task (Dev Pack Sec 7 object "Evidence"). SCHEMA EXISTS AT MVP, UI DOES NOT (PRD Sec 5.4 defers it).'
}

Table guest_session {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  client_token_hash character(64) [not null, note: 'SHA-256 (lowercase hex) of the opaque signed HttpOnly cookie value held by the PWA. The raw cookie value is NEVER stored, so a database dump cannot be replayed as a guest session.']
  author_token character(32) [not null, note: 'Same shape and same role as user_tenant_membership.author_token. Not derived from a user_id (there is none): minted as 20 random bytes at session creation, base32-encoded. Unique per tenant, so every downstream table can key on author_token alone.']
  first_seen_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, default: `now()`]
  scan_count integer [not null, default: 0, note: 'Anonymous engagement metric -- QR scans are a named Phase 1 success measure. Incremented by the QR resolve path; not an audit trail.']
  promoted_user_id uuid [note: '''Set when a guest registers, so their prior guest activity attaches to the new account WITHOUT re-keying any signal, view, scan or read-state row (those stay keyed on this session's author_token). This is the single deliberate exception to the "no user_id on guest-keyed tables" rule: it lives here, on the session, and never on an activity row.''']
  promoted_at timestamptz
  blocked_at timestamptz [note: 'Guest abuse blocking. Blocking a guest blocks a token and a device cookie, never a person -- there is no person to know.']
  blocked_reason text
  user_agent_hash character(64) [note: 'Salted SHA-256 of the user agent string. Coarse device fingerprint for abuse handling; never rendered to any user.']
  ip_hash character(64) [note: 'Salted SHA-256, never a raw address (GDPR data minimisation). Rate-limit correlation only.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_guest_session_id_tenant']
  }

  Note: '''Unauthenticated QR journeys (WRK-003 MUST). A guest is a first-class actor: it carries its own author_token so guest activity is countable, rate-limitable and blockable exactly like a member's, and so read state / views / scans need no user_id column at all. Almost always the Community tenant, but a Corporate QR scan by a passer-by also lands here (Architecture Sec 3.6).'''
}

Table learn5_binding {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, note: 'The binding is always tenant-owned even when the bound item is global. This is what lets global content be surfaced in a tenant context without duplicating the content row.']
  learn5_item_id uuid [not null]
  site_id uuid
  sub_site_id uuid
  asset_id uuid
  qr_context_id uuid
  pulse_template_id uuid [note: 'Template target. This is the ENFORCED way to attach learning to a PULSE template -- pulse_template.steps[].learn5_item_id is a per-step inline link only and cannot be a foreign key.']
  risk_type_code text [note: 'Risk-type target: binds an item to every context carrying this risk type, so a new confined-space QR inherits the confined-space Learn5 with no extra admin step.']
  priority integer [not null, default: 100, note: 'Display order within a target, ascending (0 = first). Lives on the binding, not the item, because the same item ranks differently in different contexts.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Unbinding must be reversible and must not cascade into learn5_view history.']

  Note: 'Many-to-many attachment of a learn5_item to exactly one context target (site | sub_site | asset | qr_context | pulse_template | risk_type). One join table with a nullable-target shape beats six FK columns on the item: the relationship is many-to-many, priority is a property of the relationship, and a tenant must be able to bind SafeIn5-global content (learn5_item.tenant_id IS NULL) to its own sites without cloning it.'
}

Table learn5_item {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [note: 'NULL => SafeIn5-global item, readable by all tenants. Non-null => tenant-private item. Drives the special RLS policy on this table (section 6.1).']
  title text [not null]
  summary text
  body_md text [note: 'Markdown body for delivery_mode = native. Rendered client-side; no HTML is stored.']
  media_key text [note: 'Object-store key of the primary media asset. Not a presigned URL -- URLs are minted per request with a short TTL (Architecture Sec 5).']
  media_kind text [note: 'Kind of the asset at media_key: image | video | audio | pdf.']
  external_url text [note: 'Target for delivery_mode = external (Dev Pack Sec 8.4 Option 1). Retained as the fallback adapter per PRD Sec 5.8.']
  delivery_mode text [not null, default: 'native', note: 'native (content hosted in SafeIn5, PRD Sec 5.8 decision) | external (adapter fallback, Dev Pack Sec 8.4 Option 1).']
  risk_type_code text [note: '[SIGNAL] Structured risk vocabulary, not free text -- one of the two grouping axes the future SIGNAL intelligence layer clusters on.']
  task_type_code text [note: '[SIGNAL] Structured task vocabulary, not free text -- the second SIGNAL grouping axis.']
  tags text[] [not null, default: '{}', note: '[SIGNAL] Free-form editorial tags. Complements, never replaces, risk_type_code/task_type_code.']
  estimated_seconds integer [note: 'Expected consumption time, shown to the worker before opening and used as the denominator for the Learn5 completion-rate metric (Dev Pack Sec 14).']
  version integer [not null, default: 1, note: 'Editorial version. Incremented on republish so a learn5_view recorded months ago can be read against the copy that was live at the time.']
  status text [not null, default: 'draft', note: 'one of: draft | published | archived']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Never hard delete -- learn5_view rows reference this item and the engagement metric must survive content retirement.']

  Note: 'Micro-learning content (Dev Pack Sec 8.4, Architecture Sec 2.5). tenant_id NULL means SafeIn5-global content readable by every tenant including Community (CQA-010). Because tenant_id is nullable there is no (id, tenant_id) key, so every FK pointing here is single-column and tenant agreement is enforced by the write path plus RLS.'
}

Table learn5_view {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  learn5_item_id uuid [not null]
  author_token character(32) [not null, note: 'Pseudonymous per-user-per-tenant HMAC (Architecture Sec 4.2). The ONLY actor key on this table. Do not add a user_id column -- that would re-identify anonymous learners and break the guest path.']
  source text [not null, note: '[SIGNAL] Entry point that surfaced the item: qr | pulse | feed | search | notification. Feeds the learn5.viewed outbox event (Architecture Sec 8, Sense stage).']
  qr_code_id uuid [note: '[SIGNAL] The physical code that led here, when source = qr. Ties learning engagement back to a specific sticker placement (QA-004 placement verification).']
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  dwell_ms integer [note: '[SIGNAL] Client-measured foreground time on the item. Clamped to 1 hour; a backgrounded PWA tab otherwise reports values that poison the average.']
  completed bool [not null, default: false, note: 'Materialised completion flag, set when the worker reaches the end of the item. Denormalised so the completion-rate metric is a COUNT with no CASE expression.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  Note: 'Learn5 engagement telemetry. Required, not optional: "Engagement with PULSE and Learn 5" is a named Phase 1 success metric (Dev Pack Sec 14) and cannot be reconstructed retrospectively. Keyed by author_token only -- there is intentionally no user_id column (Architecture Sec 4.3), so it behaves identically for guests and for anonymous account holders.'
}

Table moderation_action {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  target_type text [not null, note: 'Polymorphic discriminator: signal | media | user | comment. No FK by design -- four nullable FK columns and four partial indexes for a table read only by the admin console is not worth it. "comment" is seeded in the CHECK although comments do not exist at MVP, so Phase 2 comment moderation is not an ALTER.']
  target_id uuid [not null, note: 'Id of the target row in the table named by target_type. uuid for all four target types at MVP.']
  action text [not null, note: 'one of: hide | unhide | remove | edit_caption | edit_classification | block_author | mark_duplicate']
  reason_code text [note: 'Short vocabulary held in application config, not a table, at MVP: off_topic | abusive | personal_data | duplicate | incorrect_classification | test_content | other. Free text so a moderator is never blocked from acting by a missing code.']
  note text
  actor_membership_id uuid [note: 'The moderator. Moderators act under their identity; the AUTHOR they act against is only ever identified by author_token (Architecture Sec 4.4: "the moderator blocks a pseudonym and never learns a name"). Never write an author user_id into this table.']
  actor_role text
  previous_value jsonb [note: 'JSONB snapshot of the affected fields BEFORE the action. This is what makes ADM-033 (admins may change a worker classification or caption) auditable rather than destructive: without it, an admin edit silently rewrites a worker observation and the original wording is gone forever. It is also the only source for the worker-vs-reviewer disagreement analysis CQA-005 anticipates.']
  new_value jsonb [note: 'JSONB snapshot of the same fields AFTER the action. previous_value + new_value together make every admin edit replayable and reversible.']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Polymorphic moderation/admin action log (Architecture Sec 2.6). Semantically append-only: SELECT + INSERT only to runtime roles, no UPDATE/DELETE. Reversing a hide is a new unhide row, not an edit.'
}

Table notification {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  recipient_user_id uuid [note: 'NULL for broadcasts (zone-wide alerts, WRK-022) which target a scope rather than a person. Populated for a closure notification even when the underlying signal is anonymous: the dispatcher resolves author_token -> membership -> user through the Identity module only, so the identity appears here and NEVER on the signal (Architecture Sec 4.4).']
  recipient_scope jsonb [note: 'Broadcast target, e.g. {"site_id": "..."} or {"sub_site_id": "..."} (WRK-022). Fan-out to devices happens at send time, not at queue time, so a worker who joins the zone after queueing is still reached.']
  kind text [not null, note: 'one of: signal_acknowledged | signal_closed | new_needs_attention_in_zone | learn5_assigned | invitation']
  payload jsonb [not null, default: '{}', note: '''Rendered notification content plus deep-link refs. Pseudonymised like outbox payloads: it may carry authorToken and signalId, never another worker's name.''']
  channel text [not null, note: 'one of: web_push | email | in_app']
  state text [not null, default: 'queued', note: 'one of: queued | sent | failed | suppressed']
  dedupe_key text [note: 'Caller-computed idempotency key, e.g. "signal_closed:<signalId>:<userId>" or "zone_alert:<subSiteId>:<yyyymmddhh>". Enforced by uq_notification_dedupe below.']
  outbox_event_id uuid [note: 'Logical reference to outbox_event.event_id (the event that caused this notification). Deliberately NOT a foreign key: outbox_event is range-partitioned, so its only available unique key is the composite (event_id, occurred_at), and PostgreSQL cannot FK a single column against it. Joins are by value.']
  attempt_count integer [not null, default: 0]
  last_error text
  sent_at timestamptz
  read_at timestamptz [note: 'In-app read receipt. Distinct from sent_at: sent means we delivered, read means the worker actually saw it -- the difference is the honest measure of the feedback loop.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  Note: 'One row per intended delivery (recipient x channel). Rendering, sending and read state all hang off this row so "was the worker told?" is answerable from one table.'
}

Table outbox_event {
  id bigint [not null, default: `nextval('outbox_event_id_seq'::regclass)`, note: 'Monotonic ordering within a partition. Sequence-backed, not IDENTITY (PG16 does not allow identity columns on partitioned tables). Part of the PK with the partition key.']
  event_id uuid [not null, default: `gen_random_uuid()`, note: 'Consumer idempotency key. Every MVP consumer is idempotent on this value. Uniqueness is enforced as (event_id, occurred_at) because a unique constraint on a partitioned table must include the partition key; event_id is a random UUID, so this is uniqueness in practice as well as in intent.']
  tenant_id uuid [not null]
  event_type text [not null, note: 'Naming: <aggregate>.<past-tense-verb>, e.g. signal.finalised, review_task.closed, qr.scanned (Architecture Sec 8). Format enforced by CHECK so a typo cannot silently create a new event type nobody consumes.']
  event_version integer [not null, default: 1, note: '''Schema version of payload, from 1. Present from day one on purpose: a versionless event stream is unreadable in 18 months. Never mutate an existing version's shape -- increment.''']
  aggregate_type text [not null, note: 'Aggregate the event belongs to (behaviour_signal, review_task, qr_code, ...). With aggregate_id this reconstructs a per-object history.']
  aggregate_id uuid
  payload jsonb [not null, default: '{}', note: 'PSEUDONYMISED AT WRITE TIME. Carries authorToken, NEVER user_id, email or display name -- enforced structurally by ck_outbox_event_payload_pseudonymous and properly by the serialiser allowlist. This is what lets the whole stream be replayed into an analytics store without a scrubbing pass.']
  occurred_at timestamptz [not null, default: `now()`, note: 'Partition key and business time of the event. Ordering for consumers is (occurred_at, id).']
  published_at timestamptz [note: 'NULL means pending. Set by the flusher on successful publish; the row is retained forever afterwards.']
  attempt_count integer [not null, default: 0]
  last_error text [note: 'Last publish failure. Truncate before writing -- a provider stack trace loop can otherwise dominate table size.']
  next_attempt_at timestamptz [note: 'Exponential backoff schedule for the flusher. NULL means eligible immediately.']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (id, occurred_at) [pk]
    (event_id, occurred_at) [unique, name: 'uq_outbox_event_event_id']
  }

  Note: 'Transactional outbox AND the SIGNAL training corpus (Architecture Sec 8). Written in the same transaction as every domain change; published asynchronously by safein5-worker. APPEND-ONLY for the application role; only the flusher may UPDATE the delivery columns. ROWS ARE NEVER DELETED AFTER PUBLISHING DURING THE PILOT -- this stream is the single most valuable artefact the MVP produces and it cannot be reconstructed after the fact.'
}

Table pulse_session {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  author_token character(32) [not null, note: 'Deterministic per-user-per-tenant pseudonym (Architecture Sec 4.2). ALWAYS populated, anonymous or not. Never a raw user id. Guests carry one too, which is what keeps repeat-usage countable across guest and registered activity.']
  author_user_id uuid [note: 'NULL when the session was anonymous. Enforced by ck_pulse_session_anonymity -- see behaviour_signal.author_user_id for the full rationale.']
  is_anonymous bool [not null, default: false, note: 'Materialised at session start from the account setting. The setting may change later; the promise made at capture time must not.']
  guest_session_id uuid
  entry_point text [not null, default: 'direct', note: '[SIGNAL] Attribution of which entry points actually drive behaviour (qr vs direct vs feed vs notification). Written at MVP, unread by MVP features.']
  qr_code_id uuid
  pulse_template_id uuid [note: 'The template whose prompts were actually rendered. Templates are versioned rather than mutated, so this row remains interpretable months later.']
  context_snapshot jsonb [not null, default: '{}', note: 'Immutable denormalised copy of the resolved context at session start (site/sub_site/asset/task/risk/qr_context_version). Never updated. The FK columns beside it are for querying; this is historical truth -- a sub_site renamed six months later must not rewrite what the worker was actually standing in.']
  site_id uuid [note: 'Denormalised from context_snapshot purely for indexed querying. context_snapshot is authoritative for what the context meant at the time.']
  sub_site_id uuid
  asset_id uuid
  task_type_code text [note: '[SIGNAL] Structured task vocabulary copied from the resolved context. Same axis as behaviour_signal.task_type_code, so PULSE engagement and signal output can be grouped on identical keys.']
  risk_type_code text [note: '[SIGNAL] Structured risk vocabulary copied from the resolved context. See task_type_code.']
  geo_lat numeric(9,6) [note: 'Optional and permission-gated (Dev Pack Sec 5). Rounded to 3 decimal places (~110 m) by the application before storage on anonymous sessions -- Architecture Sec 4.3.']
  geo_lon numeric(9,6)
  geo_accuracy_m numeric(7,2)
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  steps_completed text[] [not null, default: '{}', note: '[SIGNAL] Which of P/U/L/S/E were actually viewed. Feeds the PULSE completion-rate success metric; unreconstructable after the fact.']
  duration_ms integer [note: '[SIGNAL] Wall-clock session duration, client-reported.']
  outcome text [not null, default: 'abandoned', note: 'abandoned | completed | completed_with_signal. Defaults to abandoned so a session that is never completed records the truth without a reaper having to write it.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Nothing in this schema is ever hard-deleted; GDPR erasure works by tombstoning the user and destroying the token mapping (Architecture Sec 4.4).']

  indexes {
    (id, tenant_id) [unique, name: 'uq_pulse_session_id_tenant']
  }

  Note: 'One PULSE (P/U/L/S/E) walkthrough. The Echo half of the Echo -> Signal pair: a session may complete without producing a behaviour_signal, and that abandonment is itself the metric (PRD Sec 5.7 repeat-scan fatigue). Anonymity shape is identical to behaviour_signal by design -- a session that could be attributed while the signal it produced could not would defeat the promise.'
}

Table pulse_template {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [note: 'NULL means a SafeIn5-global template available to every tenant (including Community). Non-NULL means tenant-private. RLS USING admits both; RLS WITH CHECK admits only the caller tenant, so the app role cannot mint global templates.']
  name text [not null]
  description text
  steps jsonb [not null, default: '[]', note: 'Ordered jsonb array of exactly 5 objects keyed P|U|L|S|E: [{"key":"P","heading":"...","prompt":"...","learn5_item_id":"<uuid>"}, ...]. steps[].learn5_item_id CANNOT be a foreign key (nested in jsonb); it is existence- and tenant-checked in the same transaction on write and degrades to a missing link on read. For an ENFORCED template-to-Learn5 relationship use learn5_binding.pulse_template_id (0004), which is a real FK.']
  risk_type_code text [note: '[SIGNAL] Risk this template is written for; drives GET /v1/pulse/templates/resolve fallback when a qr_context has no explicit template.']
  task_type_code text [note: '[SIGNAL] Optional secondary resolution axis. Symmetrical with risk_type_code; resolution prefers risk_type_code.']
  version integer [not null, default: 1, note: 'Monotonic per (tenant scope, name). Editing a published template creates a new version row rather than mutating history, so a six-month-old pulse_session can be read against the prompts actually shown.']
  status text [not null, default: 'draft', note: 'draft | active | archived. text + CHECK, never a PG ENUM, so Phase 2 adds a state with an ALTER CHECK.']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. A template referenced by a historic pulse_session must remain readable.']

  Note: 'PULSE prompt set (Architecture Sec 2.3, WRK-005 contextual PULSE prompts). One row = one versioned set of the five P/U/L/S/E steps. Referenced by qr_context.pulse_template_id and resolved by GET /v1/pulse/templates/resolve.'
}

Table qr_code {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  token character(12) [not null, unique, note: 'THE URL PATH SEGMENT: https://s5.app/q/<token>. 12 chars of Crockford base32 (no I/L/O/U -- no ambiguity, no accidental words), 60 bits of CSPRNG entropy, case-insensitive so it doubles as a human-typed fallback. Opaque: it carries no signature and no expiry, because a token that expires is a sticker that must be reprinted. All authority lives in qr_code.status, which is server-side and instantly revocable.']
  label text [not null, note: 'Human name in the admin list, e.g. "Lifting Zone 3 barrier".']
  qr_context_id uuid [note: 'Nullable while status=draft (token minted before the admin binds destinations, Sec 6.3). Re-point the sticker by UPDATEing this column.']
  status text [not null, default: 'draft', note: 'draft | active | inactive | revoked. REVOKED IS NOT DELETED. RESOLVER CONTRACT (Sec 6.2 hard rule 4): unknown token -> 200 {status:"unknown"}; inactive -> 200 {status:"inactive"}; revoked -> 200 {status:"retired", fallback:{siteName}}. Never 404 a physical safety sticker. Because unknown and revoked are distinguishable only if the row survives, revoked rows are NEVER deleted and deleted_at is never set on a revoked code that is still physically mounted.']
  sticker_serial text [note: 'Optional physical inventory serial, matching the additive ?s=<sticker_serial> query param. Never authoritative for resolution; logged for QA-004 placement verification.']
  verified_at timestamptz [note: 'QA-004 "QR tested/active": set when someone has physically scanned the mounted sticker and confirmed it routes correctly.']
  verified_by_membership_id uuid [note: 'Membership that performed the physical verification. Not anonymous -- QR verification is an admin/supervisor action (Architecture Sec 4.3).']
  printed_asset_url text [note: 'Object-store key of the generated print-ready PNG/SVG (qrcode lib, ECC level H for mud, abrasion and UV).']
  scan_count bigint [not null, default: 0, note: 'Denormalised counter, incremented fire-and-forget on resolve. The authoritative per-scan record is qr_scan_event below.']
  last_scanned_at timestamptz [note: 'Denormalised. Powers the admin "never scanned since printing" placement-check list.']
  activated_at timestamptz
  revoked_at timestamptz
  revoked_reason text [note: 'Why the sticker was retired. Never shown publicly; shown in admin and copied into the audit_log entry.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_qr_code_id_tenant']
  }

  Note: 'One physical printed QR sticker (Architecture Sec 2.3 / Sec 6). Points at a qr_context, which is what makes re-pointing a sticker an UPDATE rather than a reprint. ~30 rows in the pilot.'
}

Table qr_context {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null, note: 'Admin-facing name, e.g. "Heavy lift - Lifting Zone 3".']
  description text
  site_id uuid [note: 'Nullable. Dev Pack Sec 8.2 context dimension. Denormalised into the resolve envelope and into every context_snapshot.']
  sub_site_id uuid [note: 'Nullable. Sub-site (area / zone / task_zone / asset_group) dimension.']
  asset_id uuid [note: 'Nullable. The "Asset ID = spreader beam" dimension; the GROUP BY that carries the flagship supervisor insight.']
  task_type_code text [note: '''[SIGNAL] FK to the global task_type vocabulary. Named *_code rather than the architecture doc's bare "task_type" so the FK relationship is explicit and greppable; the resolve envelope still exposes it as taskType.''']
  risk_type_code text [note: '[SIGNAL] FK to the global risk_type vocabulary. See task_type_code for the naming rationale.']
  destinations jsonb [not null, default: '[]', note: 'Ordered jsonb array of {"type":"pulse|rescue_plan|learn5|feed|capture","ref":"<uuid>","label":"..."} (Dev Pack Sec 8.6: one QR -> survey + rescue plan + PULSE + Learn5). Order is the render order in the resolve envelope. "ref" is intentionally NOT FK-enforced -- it is polymorphic across pulse_template, rescue_plan and learn5_item. Replacement controls: same-transaction validation on write, resolve-time LEFT JOIN with silent omission on read (never 404 a printed code), soft-delete-only content, and a nightly worker integrity report. The PRIMARY destination of each kind is duplicated into the real FK columns pulse_template_id / rescue_plan_id / learn5_item_id.']
  default_destination text [note: 'one of: pulse | rescue_plan | learn5 | feed | capture. Which destination auto-opens after a scan (normally "pulse"). Matched by "type" against destinations[]; NULL means the PWA renders the destination list without auto-navigating.']
  pulse_template_id uuid [note: 'Contextual PULSE prompts (WRK-005). Redundant with a destinations[] entry of type "pulse" and deliberately so: the resolver reads this column in the single indexed join rather than parsing jsonb.']
  rescue_plan_id uuid [note: 'Primary rescue plan destination (Dev Pack Sec 8.3). Column declared in 0003, foreign key fk_qr_context_rescue_plan added in 0004 once rescue_plan exists. Same read-path rationale as pulse_template_id.']
  learn5_item_id uuid [note: 'Primary Learn5 destination. Column declared in 0003, foreign key fk_qr_context_learn5_item added in 0004. Additional Learn5 items attach through learn5_binding (qr_context_id target).']
  context_version integer [not null, default: 1, note: '[SIGNAL] Incremented by the application on every edit to the context definition. Lets a six-month-old signal be interpreted against the context definition in force at capture time; the value is copied into every context_snapshot. Backfill-impossible if omitted.']
  status text [not null, default: 'draft', note: 'draft | active | archived. Note the physical CODE has its own status (qr_code.status); this one governs the logical context.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete only. A deleted context must still resolve for audit and for historic context_snapshot interpretation.']

  indexes {
    (id, tenant_id) [unique, name: 'uq_qr_context_id_tenant']
  }

  Note: 'Resolved-destination definition for a QR entry point (Dev Pack Sec 8.2, Architecture Sec 2.3). Deliberately separate from qr_code so a physical sticker can be re-pointed by UPDATEing qr_code.qr_context_id -- no reprint, no site visit -- and so many codes can share one context.'
}

Table qr_scan_event {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  qr_code_id uuid [not null]
  qr_context_id uuid [note: 'The context the code resolved to AT SCAN TIME. Stored alongside qr_code_id so a later re-point of the sticker does not retroactively change what a historical scan meant.']
  author_token character(32) [not null, note: '''The scanner's pseudonym. Guest or member, same shape. The ONLY actor key on this table.''']
  is_first_scan_for_token bool [not null, default: false, note: '''[SIGNAL] True on this token's first ever scan of this code. Materialised at write time because it is a cheap flag now and an expensive window function later.''']
  entry_point text [not null, default: 'qr', note: '[SIGNAL] qr (camera) | manual_code (typed the human-readable fallback) | deep_link. Distinguishing the typed fallback is how "the sticker is unreadable in the field" becomes measurable rather than anecdotal.']
  sticker_serial text [note: 'Additive ?s=<serial> param captured for QA-004 placement verification. Never authoritative for resolution.']
  occurred_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  Note: '[SIGNAL] Authoritative per-scan record behind the qr.scanned outbox event (Architecture Sec 6.2 step 4, Sec 8 Sense stage). QR scans are a named Phase 1 success metric and cannot be reconstructed from the denormalised qr_code.scan_count. KEYED BY author_token ONLY -- no user_id column exists on this table and none may be added (Architecture Sec 4.3).'
}

Table rescue_plan {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  site_id uuid [note: 'Scope. Resolution order is most-specific-first: asset_id, then sub_site_id, then site_id, then tenant-wide (all three NULL).']
  sub_site_id uuid
  asset_id uuid
  title text [not null]
  location_description text [note: 'Free text describing the physical location / access point, per Dev Pack Sec 8.3 "location / asset". Supplements, never replaces, the structured site/sub_site/asset scope.']
  immediate_actions jsonb [not null, default: '[]', note: 'ORDERED array of steps: [{"seq":1,"action":"...","detail":"..."}]. Order is safety-critical; it is carried by both array position and an explicit seq key so a reserialising client cannot silently reorder it.']
  roles_responsibilities jsonb [not null, default: '[]', note: 'Array of [{"role":"...","responsibility":"..."}] (Dev Pack Sec 8.3 "roles and responsibilities").']
  required_equipment jsonb [not null, default: '[]', note: 'Array of [{"item":"...","quantity":"...","location":"..."}] (Dev Pack Sec 8.3 "required equipment").']
  escalation_contacts jsonb [not null, default: '[]', note: 'Array of [{"name":"...","role":"...","phone":"..."}] (Dev Pack Sec 8.3 "escalation contacts"). Discrete phone values so the client can render a one-tap tel: link -- the single most time-critical element on the page.']
  version integer [not null, default: 1, note: 'Version, per Dev Pack Sec 8.3 "version / review date". Displayed to the worker so a printed copy can be reconciled against the live one.']
  review_date date [note: 'Scheduled review date (Dev Pack Sec 8.3). OPEN SAFETY QUESTION: no source document says what an expired review date does. Recommendation, and the behaviour assumed here: an expired plan is still DISPLAYED, with a staleness banner. Never withhold emergency content. This column is deliberately not a display gate anywhere in the schema.']
  status text [not null, default: 'draft', note: 'one of: draft | published | archived']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_rescue_plan_id_tenant']
  }

  Note: 'Task/location-specific emergency response procedure. Fields mirror Dev Pack Sec 8.3 exactly. Structured JSONB rather than a markdown blob because the mobile rendering must be scannable in an emergency -- individual actions, roles, equipment and phone numbers must be addressable UI elements, not prose the client has to parse.'
}

Table review_task {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  signal_id uuid [not null, unique]
  state text [not null, default: 'open', note: 'Text FK to workflow_state_def.code -- deliberately not a PG enum. MVP values: open | acknowledged | closed.']
  assigned_to_membership_id uuid [note: 'Phase-2 structure (Dev Pack Sec 7 assignment step). Written at MVP only if a supervisor self-assigns; there is no assignment UI (PRD Sec 5.4). Column exists now so the Phase-2 lifecycle needs no migration against live pilot rows. ON DELETE SET NULL so GDPR erasure of a supervisor membership cannot block.']
  assigned_at timestamptz
  acknowledged_at timestamptz
  acknowledged_by_membership_id uuid
  closed_at timestamptz
  closed_by_membership_id uuid
  closure_note text [note: 'Publicly displayed on the signal card (PRD Sec 5.5) -- this is the "you were heard" loop that closes the report black hole. Treat as worker-visible text: no names, no PII; the moderation serialiser allowlist applies.']
  due_at timestamptz [note: '[SIGNAL] Response-time SLA target. No MVP feature reads it; it is written so SLA breach analysis is possible retrospectively (Dev Pack Sec 17.1 Scenario 5).']
  first_response_ms bigint [note: '[SIGNAL] Milliseconds from signal finalisation to first supervisor acknowledgement. Together with time_to_close_ms this IS the "report black hole" metric: the pilot claim is that SafeIn5 turns unanswered reports into answered ones, and these two columns are the only evidence that will exist for it. Materialised at transition time, never computed on read, because review_task rows are mutable and the source timestamps can be corrected.']
  time_to_close_ms bigint [note: '[SIGNAL] Milliseconds from signal finalisation to closure. See first_response_ms.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete (tombstone). Review tasks are never hard deleted -- the workflow_transition log would otherwise reference a vanished aggregate.']

  indexes {
    (id, tenant_id) [unique, name: 'uq_review_task_id_tenant']
  }

  Note: 'One supervisor review task per behaviour_signal. Created by the outbox consumer WorkflowTaskCreator when classification.triggers_workflow is true (needs_attention_now), or on manual supervisor pickup. At most one per signal (uq_review_task_signal) so the feed badge join stays a 1:0..1.'
}

Table risk_type {
  code text [pk, note: '[SIGNAL] Stable machine code, denormalised onto qr_context, pulse_template, learn5_item and behaviour_signal. The primary axis of Phase-2 pattern detection.']
  label text [not null, note: 'Human label for admin pickers and the PWA context chip.']
  description text
  sort_order integer [not null, default: 100]
  is_active bool [not null, default: true, note: 'false hides the code from new pickers but leaves every existing reference valid.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'Global seeded vocabulary of hazard/risk types (Dev Pack Sec 8.2 QR context dimension "risk type"). Not tenant-scoped, no RLS. Never deleted; deactivate with is_active.'
}

Table role {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [not null, unique, note: 'one of: worker | supervisor | org_admin | platform_admin | moderator. Stable machine identifier used in JWT claims (rol) and in guards. CHECK-constrained rather than a PG ENUM so a Phase-2 role is an ALTER ... CHECK plus one INSERT.']
  name text [not null]
  description text
  permissions jsonb [not null, default: '[]', note: 'Flat JSON array of permission strings, e.g. ["signal.create","feed.read"]. No RBAC engine at MVP: the Permissions guard performs a set-membership test against this array.']
  sort_order integer [not null, default: 0]
  is_active bool [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'Global reference table of the five MVP roles. Not tenant-scoped: the same role definitions apply in every tenant, and a user holds a role per membership (user_tenant_membership.role_id, migration 0002). Seeded here with fixed UUIDs so later migrations and fixtures can reference them deterministically.'
}

Table signal_classification_event {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  signal_id uuid [not null]
  from_code text [note: 'NULL on the first (worker) classification -- there was nothing to change from.']
  to_code text [not null]
  changed_by_role text [note: 'Role code at the time of the change (worker | supervisor | moderator | org_admin | platform_admin). Denormalised because roles change and this record must not.']
  changed_by_token character(32) [note: 'author_token of the actor, never a user id -- a moderator who reclassifies an anonymous signal must not become the route by which the reporter is identified.']
  reason text
  source text [not null, note: '''worker | moderator | admin. Distinguishes a worker's own correction from a third-party override, which is the axis the disagreement analysis runs on.''']
  created_at timestamptz [not null, default: `now()`]

  Note: '''[SIGNAL] Append-only log of every classification set or changed. Exists because ADM-033 permits an admin to change a worker's classification and CQA-005 anticipates deeper SIF mapping later: the DISAGREEMENT between the worker who was standing there and the reviewer who was not IS training data, and it is irrecoverable if only the final value is kept. No UPDATE or DELETE grant is issued on this table.'''
}

Table signal_media {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Client-generated UUIDv7, minted alongside the signal id so that presign is idempotent under retry.']
  tenant_id uuid [not null]
  signal_id uuid [not null]
  kind text [not null, note: 'one of: photo | video | audio']
  state text [not null, default: 'reserved', note: 'reserved -> uploading -> uploaded -> processing -> ready, with terminal failed and orphaned. orphaned means the reserved row has no object in S3 after the reconciler HEADed it, or the parent draft was reaped.']
  storage_key text [not null, note: 'Full object key, s3://bucket/{tenant_id}/{yyyy}/{mm}/{signal_id}/{media_id}.{ext}. Tenant-prefixed by constraint so retention and erasure can be executed as a prefix operation.']
  thumb_key text [note: 'sharp-generated 400px derivative. NULL until the worker has processed the original.']
  poster_key text [note: 'ffmpeg-extracted poster frame, video only.']
  mime_type text
  byte_size bigint
  width integer [note: 'Captured client-side BEFORE upload so the feed can reserve a correctly proportioned skeleton tile while the object is still in flight (Architecture Sec 5.4) -- a mis-sized placeholder that reflows on load reads as broken.']
  height integer
  duration_ms integer
  checksum_sha256 character(64) [note: 'Client-supplied lowercase hex SHA-256, verified against the stored object on finalise.']
  upload_started_at timestamptz
  upload_completed_at timestamptz
  processed_at timestamptz
  attempt_count integer [not null, default: 0, note: 'Incremented on each failed /complete or processing attempt. Feeds the 3-retry-then-failed policy; the signal itself stays visible and final when processing fails, because the observation is the value and the photo is supporting evidence.']
  last_error text
  exif_stripped bool [not null, default: true, note: 'Always true, by CHECK. EXIF including GPS and device serial is stripped unconditionally during derivative generation. This column exists to make that fact auditable per object, not to make it optional.']
  transcript_text text [note: 'Audio only. Transcription is non-blocking by construction (CQA-006: voice preferred, never required) -- a provider outage sets transcript_state=failed and nothing else changes.']
  transcript_state text [not null, default: 'none', note: 'one of: none | pending | ready | failed']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Object deletion in S3 is a separate, audited retention job.']

  Note: 'One uploaded artefact per row. Bytes never traverse the API container: the browser PUTs directly to S3 via a presigned URL, so this row is created (state=reserved) before the object exists and is promoted asynchronously. The reconciler depends on the timing columns to close the "upload succeeded but /complete never arrived" hole (Architecture Sec 5.3).'
}

Table signal_read_state {
  tenant_id uuid [not null, note: 'Present for RLS and for retention scoping; it is not part of the PK because a token is already tenant-scoped by derivation (per-tenant salt).']
  author_token character(32) [not null, note: '''The READER's token, not the author's. Guests carry a token too, which is the only reason guest read state works at all.''']
  signal_id uuid [not null]
  seen_at timestamptz [not null, default: `now()`, note: 'Card scrolled into view. This is the value the "caught up" boundary is computed against.']
  opened_at timestamptz [note: 'Card actually opened. NULL means seen but not read -- the difference between the two is the feed engagement metric.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    (author_token, signal_id) [pk]
  }

  Note: '''Per-reader read state. Powers WRK-013's "You are caught up!" boundary in the feed. Deliberately has NO user_id column of any kind: it is keyed by author_token ONLY, so read state behaves identically for guests, anonymous users and attributed users, and destroying the token mapping at GDPR erasure clears attributability by construction. Composite PK (author_token, signal_id) -- one row per reader per signal, upserted on view.'''
}

Table site {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name text [not null]
  city text
  country_code character(2)
  timezone text [not null, default: 'Europe/London', note: '[SIGNAL] IANA timezone name. Shift and time-of-day pattern analysis requires local time, and this is uncorrectable retrospectively once signals have been captured against a wrong or absent zone.']
  centroid_lat numeric(9,6) [note: '[SIGNAL] Site centroid latitude, numeric(9,6) (~0.1 m precision). Feeds geo clustering and proximity context resolution (ADM-006).']
  centroid_lon numeric(9,6) [note: '[SIGNAL] Site centroid longitude. See centroid_lat.']
  status text [not null, default: 'active', note: 'one of: active | inactive']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Sub-sites, assets, QR contexts and signals reference this row.']

  indexes {
    (id, tenant_id) [unique, name: 'uq_site_id_tenant']
  }

  Note: 'A physical site (e.g. a quarry) belonging to a tenant (= one client organisation). Top of the context hierarchy used by QR resolution, feed scoping and user_site_assignment.'
}

Table sub_site {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  site_id uuid [not null]
  parent_sub_site_id uuid [note: 'Optional parent sub-site, same site and same tenant. Nullable self-FK: SafeIn5 explicitly warned against complex hierarchy (WRK-013 amendment), so MVP caps depth at 1 -- but the column costs nothing now and avoids a migration if Phase 2 needs depth.']
  name text [not null]
  kind text [not null, default: 'area', note: 'area | zone | task_zone | asset_group. Structured rather than free text because these are grouping keys the future SIGNAL layer depends on (Open-Questions: hierarchy model).']
  centroid_lat numeric(9,6) [note: '[SIGNAL] Zone centroid latitude; geo-based context resolution and clustering.']
  centroid_lon numeric(9,6) [note: '[SIGNAL] Zone centroid longitude.']
  status text [not null, default: 'active', note: 'one of: active | inactive']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz

  indexes {
    (id, tenant_id) [unique, name: 'uq_sub_site_id_tenant']
  }

  Note: 'A named area/zone within a site -- the level at which QR codes, feeds and Learn5 bindings are usually scoped. Self-nesting is permitted structurally but capped at one level of nesting in MVP by trg_sub_site_depth_cap.'
}

Table task_type {
  code text [pk, note: '[SIGNAL] Stable machine code. This is the value denormalised onto qr_context, pulse_session and behaviour_signal; it must never be renamed once written. One of the two grouping keys Phase-2 pattern detection runs on.']
  label text [not null, note: 'Human label rendered in admin and in the PWA context chip ("Brackley North . Lifting Zone 3 . Heavy Lift").']
  description text
  sort_order integer [not null, default: 100, note: 'Display order in admin pickers. Ascending.']
  is_active bool [not null, default: true, note: 'false hides the code from new pickers but leaves every existing reference valid.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'Global seeded vocabulary of work-task types (Dev Pack Sec 8.2 QR context dimension "task type"). Not tenant-scoped, no RLS: shared reference data. Never deleted; deactivate with is_active so historic qr_context / behaviour_signal rows keep resolving.'
}

Table tenant {
  id uuid [pk, default: `gen_random_uuid()`]
  slug citext [not null, unique, note: '''URL/login-hint identifier, e.g. 'community', 'brackley-aggregates'. citext so uniqueness is case-insensitive.''']
  kind text [not null, note: 'community | corporate. Drives visibility defaults, moderation model and guest rules.']
  name text [not null]
  industry_code text [note: '[SIGNAL] Written at MVP, unread by any MVP feature. Sector code (e.g. SIC/NAICS-style) that lets the Phase-2 intelligence layer benchmark behaviour patterns across comparable industries. Unrecoverable retrospectively at scale, free to capture now.']
  country_code character(2) [note: 'ISO 3166-1 alpha-2, uppercase.']
  is_public_readable bool [not null, default: false, note: 'true only for the Community tenant -- the single tenant whose final, visible signals are readable unauthenticated (Architecture Sec 3.3 community_public_read policy).']
  allow_guest_submission bool [not null, default: false, note: 'Per-tenant switch resolving the open question in WRK-003. Community pilot ships false (PRD Sec 5.6 "guest reads, account writes") but is flippable without a deploy or a migration.']
  data_region text [not null, default: 'eu-west-1', note: '''Storage/compute region for this tenant's data. EU residency NFR; default eu-west-1.''']
  theme jsonb [not null, default: '{}', note: 'MVP theming scope is logo + colour only: {"logo_url": "...", "colour_tokens": {...}}.']
  retention_policy jsonb [not null, default: '{"audit_days": 2555, "media_days": 365, "signals_days": 730}', note: '{signals_days, media_days, audit_days}. Read by the nightly retention job (GDPR NFR); per-tenant because corporate contracts and the Community tenant will not agree on retention.']
  status text [not null, default: 'active', note: 'one of: active | suspended']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. Never hard delete a tenant -- its signals are referenced by audit_log and outbox_event, which are append-only.']

  Note: '''The RLS anchor. Every tenant-scoped table references tenant(id) and every RLS policy keys on current_setting('app.tenant_id'). One tenant IS one client organisation: the customer-facing organisation profile (name, industry_code, country_code) lives on this row, which is why the org_admin role administers a tenant. Deliberately NOT tenant-scoped and NOT RLS-protected: it is the root of the tenancy graph, and platform-admin paths read it via runAsSystem.'''
}

Table tenant_secret {
  tenant_id uuid [pk]
  author_token_salt bytea [not null, note: '16 CSPRNG bytes, generated once at tenant creation and never rotated in normal operation -- rotating it would fork every existing pseudonym in the tenant and destroy repeat-usage continuity. See salt_version / rotated_at for the escape hatch.']
  salt_version integer [not null, default: 1, note: 'Incremented only if a salt must be rotated after a suspected compromise. Bumping it deliberately invalidates every historical author_token in the tenant; the migration that does it must also decide what happens to existing signals.']
  pepper_key_ref text [note: 'Opaque KMS key identifier (ARN / key name) naming WHICH pepper was used -- never the pepper itself. Lets the pepper be rotated in KMS without losing the ability to reproduce historical tokens.']
  rotated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: '''Soft delete. NOTE: tenant-level erasure is one of the very few operations permitted to hard-DELETE a row in SafeIn5 -- destroying the salt is what makes an entire tenant's pseudonyms permanently unresolvable. Routine deactivation soft-deletes.''']

  Note: '''Per-tenant 16-byte salt used to derive author_token: base32(HMAC-SHA256(kms_pepper, author_token_salt || ':' || user_id)[0..19]) (Architecture Sec 4.2). One row per tenant, PK = tenant_id. The KMS pepper is NEVER stored here or anywhere in this database. SELECT is granted only to safein5_identity (0007).'''
}

Table user_site_assignment {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null, note: 'RLS anchor. Denormalised from the membership; the composite FKs force it to equal user_tenant_membership.tenant_id and site.tenant_id, so a cross-tenant assignment is structurally impossible rather than merely improbable.']
  membership_id uuid [not null]
  site_id uuid [not null]
  sub_site_id uuid [note: 'Optional narrowing (ADM-027/029). NULL = assigned to the whole site. A row with a sub_site_id does not imply a separate site-level row; site scope is derived from site_id either way.']
  is_primary bool [not null, default: false, note: 'The worker home/bench site that ADM-019 and ADM-023 actually need. At most one live primary per membership (uq_user_site_assignment_one_primary). Never used to restrict where a worker may capture a signal.']
  assignment_source text [not null, default: 'admin', note: '[SIGNAL] How the assignment arose: admin | invitation | self_service | qr_scan | import. Written at MVP, unread by MVP features. qr_scan anticipates WRK-015/016 auto-attachment when a worker repeatedly scans at a site they are not rostered to -- the contractor pattern.']
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by_membership_id uuid
  unassigned_at timestamptz [note: 'Soft end of an assignment. Kept rather than deleted so a signal captured six months ago can still be interpreted against the roster in force at the time.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete (data-entry correction). Ending an assignment normally sets unassigned_at, not this.']

  Note: 'TRUE many-to-many join: one membership may hold MANY concurrent site/sub-site assignments. Deliberately not a site_id column on user_tenant_membership -- ADM-019/023 imply one-worker-one-site but WRK-015/016/017/018 (all MUST) require workers to move between sites, and the pilot runs contractors across 3 organisations (i.e. 3 tenants). ADM-019 is honoured as a default UI filter plus the is_primary flag. Drives default feed scope (WRK-013/014) and supervisor scope.'
}

Table user_tenant_membership {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  user_id uuid [not null]
  role_id uuid [not null]
  author_token character(32) [not null, note: '''Deterministic per-user-per-tenant pseudonym: base32(HMAC-SHA256(kms_pepper, tenant_secret.author_token_salt || ':' || user_id)[0..19]), 32 chars. safein5_app is granted SELECT column-by-column on this table with author_token OMITTED, so the pseudonym mapping is a deliberate lookup (safein5_identity) rather than an ambient one. Destroying this row (GDPR erasure) makes every historical author_token permanently unresolvable.''']
  anonymous_override bool [note: 'NULL = inherit app_user.default_anonymous. true/false = this tenant-specific choice wins. Nullable three-state on purpose: a user may post openly in their employer tenant and anonymously in Community, or the reverse.']
  invited_at timestamptz [note: 'ADM-026 automated invitation dispatch. The invitation token itself lives in auth_token (kind=invitation) and is stored only as a hash.']
  invited_by_membership_id uuid
  accepted_at timestamptz [note: 'Set when the invitee first exchanges their invitation token. invited_at -> accepted_at is the ADM-026 funnel and is emitted as user.invited / user.accepted on the outbox (Architecture Sec 8, Platform events).']
  blocked_at timestamptz [note: 'Abuse blocking (Dev Pack Sec 17.2 Scenario 4). A moderator blocks a TOKEN, never a name: the API resolves signal.author_token -> this row through the Identity module only and returns nothing about who it was (Architecture Sec 4.4).']
  blocked_reason text [note: 'Free-text moderator justification. Mirrored into moderation_action with the token, never the identity.']
  blocked_by_membership_id uuid
  removed_at timestamptz
  status text [not null, default: 'invited', note: 'invited | active | blocked | removed. text + CHECK, never a PG ENUM. removed is a soft state -- the row and its author_token survive so historical signals stay attributable to a stable pseudonym.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  deleted_at timestamptz [note: 'Soft delete. NOTE: GDPR erasure is the one path that genuinely DELETEs rows here -- destroying the token mapping is precisely what converts retained signals into non-personal data (Architecture Sec 4.4 step 2). Every other removal sets status=removed.']

  indexes {
    (id, tenant_id) [unique, name: 'uq_user_tenant_membership_id_tenant']
  }

  Note: 'Person x tenant join, and the anonymity keystone: it holds the only stored mapping from a user to their per-tenant pseudonymous author_token (Architecture Sec 2.2/4.2). Roles, invitation state, blocking and the anonymity override are all per-tenant facts and live here, not on app_user.'
}

Table workflow_state_def {
  code text [pk, note: 'Stable machine code. review_task.state FKs to this, which is why states are a table lookup rather than a PG enum (Phase 2 = INSERT, not ALTER TYPE).']
  label text [not null]
  sort_order integer [not null, unique]
  is_terminal bool [not null, default: false, note: 'No outbound enabled transitions expected. Used by the metrics projector to stop the time_to_close clock.']
  requires_evidence bool [not null, default: false, note: 'Dev Pack Sec 7 "evidence required before close (configurable)". Configurable is exactly this column. False at MVP because PRD Sec 5.4 ships no evidence UI -- see the evidence table below.']
  enabled_in_mvp bool [not null, default: false, note: 'False for the Dev Pack states the MVP does not implement (assigned, actioned). The API transition guard rejects any target state where this is false, so Phase 2 enablement is a seed change plus UI, not a migration.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  Note: 'Config-as-data definition of the review-task state machine states. Global reference table, NOT tenant-scoped: the lifecycle is a product decision, not a per-customer setting, at MVP. Seeded with the full Dev Pack Sec 7 lifecycle; enabled_in_mvp gates the PRD Sec 5.4 subset.'
}

Table workflow_transition {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  review_task_id uuid [not null]
  from_state text [note: 'NULL for the creation transition (nothing -> open).']
  to_state text [not null]
  actor_membership_id uuid [note: 'Supervisor/admin actions are never anonymous, so a membership id is correct here (contrast audit_log.actor_token, which masks anonymous authors). NULL when the actor is the system (outbox consumer creating the task) or when the membership has since been erased.']
  actor_role text [note: 'Role code snapshotted at transition time. Denormalised deliberately: a membership role can change, but who-did-what-under-which-role must not.']
  note text
  created_at timestamptz [not null, default: `now()`]

  Note: 'APPEND-ONLY event log of every review_task state change. Directly satisfies Dev Pack Sec 7 rule "each state change logged". No UPDATE/DELETE grant to any runtime role (0007) -- correcting a transition means appending a compensating one. There is no updated_at column by design.'
}

Table workflow_transition_def {
  id uuid [pk, default: `gen_random_uuid()`]
  from_code text [not null]
  to_code text [not null]
  required_permission text [not null, note: 'Flat permission string checked against role.permissions jsonb (no RBAC engine at MVP -- set membership only). Values match the strings seeded into role.permissions in migration 0001.']
  enabled bool [not null, default: false, note: 'The single switch separating PRD Sec 5.4 (MVP) from Dev Pack Sec 7 (Phase 2).']
  note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz

  indexes {
    (from_code, to_code) [unique, name: 'uq_workflow_transition_def_pair']
  }

  Note: 'Config-as-data edge list of the review-task state machine. The application transition guard is a single lookup against this table: a transition that is absent or enabled=false is a 409, regardless of caller role.'
}

// ---------- Relationships ----------
Ref fk_asset_site: asset.(site_id, tenant_id) > site.(id, tenant_id)
Ref fk_asset_sub_site: asset.(sub_site_id, tenant_id) > sub_site.(id, tenant_id)
