{
  "name": "safein5-be",
  "version": "0.1.0",
  "description": "SafeIn5 backend API",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "smoke:realtime": "node scripts/smoke-realtime.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-sesv2": "^3.1120.0",
    "@aws-sdk/client-sns": "^3.1120.0",
    "@aws-sdk/client-transcribe": "^3.1120.0",
    "@aws-sdk/lib-storage": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/websockets": "^11.2.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "jose": "^6.2.10",
    "kysely": "^0.28.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.14.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "aws-sdk-client-mock": "^4.1.0",
    "docx": "^9.7.1",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "puppeteer": "^25.9.0",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
