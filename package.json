    "@aws-sdk/s3-request-presigner": "^3.1081.0",
    "@fastify/cookie": "^11.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "fastify": "^5.9.0",
    "ffmpeg-static": "^5.3.0",
    "jose": "^5.10.0",
